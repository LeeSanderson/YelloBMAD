<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Use-case slice tests, mirroring the {Area}/{UseCase} folder structure of Yello.Application. NOT release-gating: the fifth test project and the only one that is not a gate.
  -->

  <!--
    Runs on Microsoft.Testing.Platform only: xunit.v3 4.0.0 depends on
    xunit.v3.mtp-v2 [4.0.0]. There is no VSTest path here, so Microsoft.NET.Test.Sdk is
    deliberately absent.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    NO `ignore-exit-code 8` SWITCH HERE ANY MORE. This suite gained its first test - the shared
    fixture smoke test - so the switch came off, exactly as the comment that used to sit here
    instructed. Left in place it would swallow a genuinely empty run, so a filter typo or
    broken discovery would pass silently as "zero tests".

    A gate enforces that now rather than a comment: Yello.Tests.Architecture asserts that no
    project carrying the switch contains a [Fact] or a [Theory]. The suites that hold no cases
    yet keep it; this one cannot.

    Two things about that gate are worth knowing before relying on it. It recognises the
    combined attribute form - [Theory, InlineData(1)] - which it did not until the second
    review pass, and which is the shape story 1.9's isolation cases will take. And it parses
    the switch's value rather than substring-matching it, so the multi-code form
    `ignore-exit-code 2;8` is recognised as carrying 8. Both were holes that let a POPULATED
    release-gating suite keep the switch with the gate reporting green.
  -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!--
      For the fixture smoke test, which opens one connection to assert that the engine behind
      the pinned tag really is SQL Server 2025. .NET ships no SQL driver.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Yello.Application\Yello.Application.csproj" />
    <ProjectReference Include="..\..\Yello.Domain\Yello.Domain.csproj" />
    <ProjectReference Include="..\..\Yello.Infrastructure\Yello.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Yello.Host\Yello.Host.csproj" />
    <ProjectReference Include="..\Yello.Tests.Shared\Yello.Tests.Shared.csproj" />
  </ItemGroup>

</Project>
