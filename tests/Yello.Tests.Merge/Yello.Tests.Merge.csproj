<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The merge conformance suite. Release-gating, so strict: no ignored exit code of any value. The cases reach
    the merge only through Candidate.Strategy, and the falsification double (whole-field last-writer-wins)
    must keep failing them.
  -->

  <!--
    Runs on Microsoft.Testing.Platform only: xunit.v3 4.0.0 depends on
    xunit.v3.mtp-v2 [4.0.0]. There is no VSTest path here, so Microsoft.NET.Test.Sdk is
    deliberately absent.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Yello.Merge\Yello.Merge.csproj" />
    <ProjectReference Include="..\..\Yello.Contracts\Yello.Contracts.csproj" />
  </ItemGroup>

</Project>
