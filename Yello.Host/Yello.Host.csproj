<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Ring 5. The outermost ring: Minimal API endpoints, the /sync WebSocket and the
    composition root. Story 1.1 adds none of the first two.
  -->

  <!--
    The SQL driver, for AC4's one-shot connectivity check only. See the rationale in
    Directory.Packages.props: the plain driver rather than the Aspire client integration,
    because that integration wires a database health check by default and AR-33 requires
    probes to answer from process state with no database round trip.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <!--
    The same one-project grant Yello.Infrastructure makes, for the same reason: the Space-resolution
    filter is internal, and the rules it applies to an endpoint's result (roll back a failure, refuse
    a query still to be run) are only reachable over the wire through a Space-scoped endpoint that
    writes or streams, which the product does not have. The slice tests drive the filter directly.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Yello.Tests.Slices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yello.Domain\Yello.Domain.csproj" />
    <ProjectReference Include="..\Yello.Application\Yello.Application.csproj" />
    <ProjectReference Include="..\Yello.Infrastructure\Yello.Infrastructure.csproj" />
    <ProjectReference Include="..\Yello.Contracts\Yello.Contracts.csproj" />
    <ProjectReference Include="..\Yello.Merge\Yello.Merge.csproj" />
  </ItemGroup>

</Project>
