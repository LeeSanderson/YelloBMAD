// Yello's one Azure environment (story 1.10). There is no environment parameter and no second
// deployment target: a second Azure environment would consume the same free grants that make this
// one free (AC4). Local is `aspire run`; this is the other one.
//
// Deployed by the operator once, by hand (docs/operations.md, runbook P1-P3), with:
//   az deployment group create --resource-group <rg> --template-file infra/main.bicep \
//     --parameters @infra/main.parameters.json <the secure parameters, on the command line>
// Every later release is the GitHub workflow (.github/workflows/ci.yml), which changes images only.
//
// No secret is written here. The two connection strings and the SQL administrator password are
// secure parameters the operator supplies at deployment time; they land in Key Vault and in the SQL
// logical server, and never in source, in appsettings or in an image (AC3, AR-37).

targetScope = 'resourceGroup'

@description('Azure region for every resource. Incidental, and NOT the PRD section 6.4 "stated data region" (docs/operations.md).')
param location string = resourceGroup().location

@description('A short lowercase prefix for resource names, unique enough for the globally named ones (registry, key vault, SQL server).')
@minLength(3)
@maxLength(12)
param namePrefix string

@description('The operator alert address the action group notifies (P1).')
param operatorEmail string

@description('Entra object id of the SQL logical server administrator (P2).')
param sqlEntraAdminObjectId string

@description('Display name of the SQL logical server administrator (P2).')
param sqlEntraAdminLogin string

@description('Login name of the SQL administrator; its password is a secure parameter (open question 8 (b)).')
param sqlAdministratorLogin string

@secure()
@description('Password of the SQL administrator. Generated by the operator at the first deployment, never stored in source.')
param sqlAdministratorPassword string

@secure()
@description('The Host identity\'s connection string (db_datareader + db_datawriter). Empty keeps the stored secret unchanged.')
param appConnectionString string = ''

@secure()
@description('The migration identity\'s connection string (schema rights). Empty keeps the stored secret unchanged.')
param migrateConnectionString string = ''

@description('GitHub repository allowed to deploy, as owner/name (P3).')
param githubRepository string

@description('The Host image. The workflow replaces it on every release; pass the running image when re-deploying this template.')
param hostImage string = 'mcr.microsoft.com/dotnet/samples:aspnetapp'

@description('The migration bundle image. The workflow replaces it on every release.')
param migrateImage string = 'mcr.microsoft.com/dotnet/runtime-deps:10.0'

@description('Minimum replicas of the Host. 0 keeps the cost near zero and makes NFR-5 a warm-path measure until story 2.9 (open question 6).')
@allowed([
  0
  1
])
param minReplicas int = 0

@description('Optional custom hostname for the client (P4), e.g. app.example.org. Empty uses the Static Web App default hostname.')
param clientCustomHostname string = ''

@description('Optional custom hostname for the API (P4), e.g. api.example.org. Bound by the runbook; used here only for outputs.')
param apiCustomHostname string = ''

@description('First day of the budget period, yyyy-MM-01.')
param budgetStartDate string

@description('Monthly budget in the subscription\'s billing currency (PRD section 6.3: GBP 30).')
param monthlyBudget int = 30

var tags = {
  application: 'yello'
}

var registryName = toLower(replace('${namePrefix}acr', '-', ''))
var keyVaultName = '${namePrefix}-kv'
var sqlServerName = '${namePrefix}-sql'

// The roles, by their built-in ids.
var roles = {
  acrPull: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')
  acrPush: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8311e382-0749-4cb8-b61a-304f252e45ec')
  keyVaultSecretsUser: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')
  contributor: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')
}

// THREE IDENTITIES, EACH WITH ONLY WHAT IT NEEDS (docs/operations.md section 9).
//   id-yello-app      the Host: pulls its image, reads its connection secret; in SQL, data only.
//   id-yello-migrate  the migration job: pulls its image, reads its connection secret; in SQL, schema.
//   id-yello-deploy   the GitHub workflow, by OIDC federation: pushes images, updates the app and job.
resource appIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-yello-app'
  location: location
  tags: tags
}

resource migrateIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-yello-migrate'
  location: location
  tags: tags
}

resource deployIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-yello-deploy'
  location: location
  tags: tags
}

// The workflow logs in as the deploy identity through GitHub's OIDC token, for the one GitHub
// environment `azure`. No long-lived Azure secret is stored in GitHub (P3).
resource deployFederation 'Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials@2023-01-31' = {
  parent: deployIdentity
  name: 'github-azure-environment'
  properties: {
    issuer: 'https://token.actions.githubusercontent.com'
    subject: 'repo:${githubRepository}:environment:azure'
    audiences: [
      'api://AzureADTokenExchange'
    ]
  }
}

// Basic, admin user disabled: images are pulled by managed identity, so no registry credential
// exists anywhere (open question 2 (a)).
resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: registryName
  location: location
  tags: tags
  sku: {
    name: 'Basic'
  }
  properties: {
    adminUserEnabled: false
  }
}

resource appPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(registry.id, appIdentity.id, roles.acrPull)
  scope: registry
  properties: {
    roleDefinitionId: roles.acrPull
    principalId: appIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

resource migratePull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(registry.id, migrateIdentity.id, roles.acrPull)
  scope: registry
  properties: {
    roleDefinitionId: roles.acrPull
    principalId: migrateIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

resource deployPush 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(registry.id, deployIdentity.id, roles.acrPush)
  scope: registry
  properties: {
    roleDefinitionId: roles.acrPush
    principalId: deployIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

// Key Vault in RBAC mode. The two runtime identities read secrets; nobody else is granted anything.
resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: keyVaultName
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: {
      family: 'A'
      name: 'standard'
    }
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 7
  }
}

resource appConnectionSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = if (!empty(appConnectionString)) {
  parent: keyVault
  name: 'yello-app-connection'
  properties: {
    value: appConnectionString
  }
}

resource migrateConnectionSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = if (!empty(migrateConnectionString)) {
  parent: keyVault
  name: 'yello-migrate-connection'
  properties: {
    value: migrateConnectionString
  }
}

// THE COMMUNICATION SERVICES KEY - A NAMED, DISABLED SLOT (open question 9 (a)).
// No email feature exists until story 4.1 (the outbox), so no ACS resource is provisioned and no
// secret is created. When 4.1 lands it adds, here: the ACS resource, a Key Vault secret named
// 'yello-acs-connection', and in the Host's container a secret reference to it exposed as
// 'ConnectionStrings__acs'. Tracked in deferred-work.md against story 4.1.

resource appSecretsUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(keyVault.id, appIdentity.id, roles.keyVaultSecretsUser)
  scope: keyVault
  properties: {
    roleDefinitionId: roles.keyVaultSecretsUser
    principalId: appIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

resource migrateSecretsUser 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(keyVault.id, migrateIdentity.id, roles.keyVaultSecretsUser)
  scope: keyVault
  properties: {
    roleDefinitionId: roles.keyVaultSecretsUser
    principalId: migrateIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

module monitoring 'modules/monitoring.bicep' = {
  name: 'monitoring'
  params: {
    location: location
    tags: tags
    operatorEmail: operatorEmail
    budgetStartDate: budgetStartDate
    monthlyBudget: monthlyBudget
  }
}

module sql 'modules/sql.bicep' = {
  name: 'sql'
  params: {
    location: location
    tags: tags
    serverName: sqlServerName
    entraAdminObjectId: sqlEntraAdminObjectId
    entraAdminLogin: sqlEntraAdminLogin
    administratorLogin: sqlAdministratorLogin
    administratorPassword: sqlAdministratorPassword
    actionGroupId: monitoring.outputs.actionGroupId
  }
}

module web 'modules/web.bicep' = {
  name: 'web'
  params: {
    tags: tags
    customHostname: clientCustomHostname
  }
}

var clientHostname = empty(clientCustomHostname) ? web.outputs.defaultHostname : clientCustomHostname

module containers 'modules/containers.bicep' = {
  name: 'containers'
  params: {
    location: location
    tags: tags
    hostImage: hostImage
    migrateImage: migrateImage
    minReplicas: minReplicas
    registryServer: registry.properties.loginServer
    appIdentityId: appIdentity.id
    migrateIdentityId: migrateIdentity.id
    keyVaultUri: keyVault.properties.vaultUri
    clientOrigin: 'https://${clientHostname}'
    workspaceName: monitoring.outputs.workspaceName
  }
  dependsOn: [
    appPull
    migratePull
    appSecretsUser
    migrateSecretsUser
    appConnectionSecret
    migrateConnectionSecret
  ]
}

// The deploy identity updates exactly the two container resources and reads the Static Web App's
// deployment token; it is granted nothing else in the resource group.
resource hostApp 'Microsoft.App/containerApps@2024-03-01' existing = {
  name: 'yello-host'
}

resource migrateJob 'Microsoft.App/jobs@2024-03-01' existing = {
  name: 'yello-migrate'
}

resource staticSite 'Microsoft.Web/staticSites@2023-12-01' existing = {
  name: 'yello-client'
}

resource deployHost 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, 'yello-host', deployIdentity.id, roles.contributor)
  scope: hostApp
  properties: {
    roleDefinitionId: roles.contributor
    principalId: deployIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
  dependsOn: [
    containers
  ]
}

resource deployJob 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, 'yello-migrate', deployIdentity.id, roles.contributor)
  scope: migrateJob
  properties: {
    roleDefinitionId: roles.contributor
    principalId: deployIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
  dependsOn: [
    containers
  ]
}

resource deployClient 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, 'yello-client', deployIdentity.id, roles.contributor)
  scope: staticSite
  properties: {
    roleDefinitionId: roles.contributor
    principalId: deployIdentity.properties.principalId
    principalType: 'ServicePrincipal'
  }
  dependsOn: [
    web
  ]
}

// What the deploy workflow and the runbook read. Identifiers and hostnames only - no secret.
output hostFqdn string = containers.outputs.hostFqdn
output apiHostname string = empty(apiCustomHostname) ? containers.outputs.hostFqdn : apiCustomHostname
output clientHostname string = clientHostname
output registryLoginServer string = registry.properties.loginServer
output keyVaultName string = keyVault.name
output sqlServerFqdn string = sql.outputs.serverFqdn
output appIdentityClientId string = appIdentity.properties.clientId
output migrateIdentityClientId string = migrateIdentity.properties.clientId
output deployIdentityClientId string = deployIdentity.properties.clientId
