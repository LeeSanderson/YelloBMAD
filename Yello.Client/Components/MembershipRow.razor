@using System.Globalization
@using Yello.Client.Spaces
@using Yello.Contracts.Memberships

@inject IStringLocalizer<ClientCopy> Localizer

@*
    ONE MEMBERSHIP IN SPACE SETTINGS' MEMBERS SECTION. FR-13, FR-14; UX-DR11, UX-DR14, UX-DR27, UX-DR34, UX-DR36,
    UX-DR39.

    Its initials avatar (monospace, from the display name alone), its label - the display name, with a Membership-scoped
    discriminator only when another Membership here carries the same name (MembershipLabels; AC3) - "· You" on one's own
    row, its address (here, and nowhere else in the product: UX-DR34), and its Role as a fixed chip.

    "CHANGE ROLE" ONLY WHERE THE VIEWER MAY CHANGE IT (MembershipCapabilities.OfferableRoles): every other row for the
    Owner; Member and Viewer rows for an Admin. Elsewhere the control is ABSENT from the DOM (UX-DR27) - the Owner's row,
    one's own row, and an Admin's view of another Admin's row are the chip alone.

    THE PICKER OPENS IN PLACE (Q12 (a); UX-DR11): the control is replaced by a fieldset whose legend names the row and its
    current Role, a radio per offerable Role with NO OPTION CHECKED - the choice is consequential, so there is no default -
    then "Change" and "Cancel". Never a dialog. Esc or Cancel restores the control with focus on it.

    IN FLIGHT, the status line replaces the control and takes focus, so focus never falls to body (ledger :762, Q14 (a)).
    Not optimistic: the chip keeps the current Role until the server answers.

    "REMOVE" ONLY WHERE THE VIEWER MAY REMOVE THE ROW (MembershipCapabilities.Removable): every other row for the Owner;
    Member and Viewer rows for an Admin; never one's own row (leaving is Space home's) and never the Owner's. Elsewhere it
    is absent from the DOM. Its accessible name carries the row's label, so several are not identical controls.

    THE REMOVAL CONFIRM is the Membership rung of the destructive-confirm ladder: above a Task's (which names the Task and
    says it cannot be undone) because it ends someone's access to everything in the Space at once, below a Project's (which
    names its Task count). It replaces the row's controls in place - never a dialog - names the person by the row's label,
    never the address, states the consequence and whether they are in this Space now (read fresh by the section when the
    confirm opens; the sentence appears once that read answers), then "Remove" and "Cancel". Neither is a default: focus
    opens on the confirm's text. No typed confirmation - that rung is the Space's. Esc or Cancel restores Remove, focused.
*@

<li class="membership-row">
    <span class="membership-row__avatar" aria-hidden="true">@MembershipLabels.Initials(Membership.DisplayName)</span>
    <span class="membership-row__name" id="@NameId">@Label</span>

    @if (Membership.IsYou)
    {
        <span class="membership-row__you">@Localizer["MembershipYou"]</span>
    }

    <span class="membership-row__address">@Membership.EmailAddress</span>
    <RoleChip Role="@Membership.Role" />

    @if (Membership.InSpaceNow)
    {
        <span class="membership-row__present type-meta">@Localizer["MembershipInSpaceNow"]</span>
    }

    @if (Picking)
    {
        <fieldset class="membership-row__picker" @onkeydown="PickerKeyDownAsync">
            <legend class="form-field__label">@Legend</legend>

            @foreach (var (roleCode, at) in Options)
            {
                <label class="membership-row__option">
                    <input type="radio" name="@_groupName" value="@roleCode" checked="@(_chosen == roleCode)" @onchange="Choose" @ref="_options[at]" />
                    @Localizer[RoleCopy.NameKey(roleCode)]
                </label>
            }

            @if (_chooseMessage is { } chooseMessage)
            {
                <p class="form-field__message" role="status">@chooseMessage</p>
            }

            <span class="membership-row__actions">
                <button type="button" class="button-primary" @onclick="ChangeAsync">@Localizer["MembershipChange"]</button>
                <button type="button" class="button-secondary" @onclick="CancelAsync">@Localizer["MembershipCancel"]</button>
            </span>
        </fieldset>
    }

    @if (Changing)
    {
        <span class="membership-row__progress" role="status" tabindex="-1" @ref="_progress">@Localizer["MembershipChanging"]</span>
    }

    @if (ShowsControl)
    {
        <button type="button" class="button-secondary" aria-describedby="@NameId" @onclick="AskAsync" @ref="_control">@Localizer["MembershipChangeRole"]</button>
    }

    @if (ShowsRemove)
    {
        <button type="button" class="button-secondary" aria-label="@RemoveName" @onclick="AskToRemoveAsync" @ref="_remove">@Localizer["MembershipRemove"]</button>
    }

    @if (ConfirmingRemoval)
    {
        <span class="destructive-confirm membership-row__confirm" @onkeydown="ConfirmKeyDownAsync">
            <span class="membership-row__confirm-text" tabindex="-1" @ref="_confirmText">
                <span>@RemoveQuestion</span>
                @if (LiveSentence is { } live)
                {
                    <span>@live</span>
                }
            </span>
            <span class="membership-row__actions">
                <button type="button" class="button-danger" aria-describedby="@NameId" @onclick="RemoveAsync">@Localizer["MembershipRemoveConfirm"]</button>
                <button type="button" class="button-secondary" @onclick="CancelRemovalAsync">@Localizer["MembershipRemoveCancel"]</button>
            </span>
        </span>
    }

    @if (Removing)
    {
        <span class="membership-row__progress" role="status" tabindex="-1" @ref="_removing">@Localizer["MembershipRemoving"]</span>
    }

    @if (Refusal is { } refusal)
    {
        <p class="membership-row__refusal" role="status">@refusal</p>
    }
</li>

@code {
    // A radio group name unique to this row's picker.
    private readonly string _groupName = Guid.NewGuid().ToString("N");

    private ElementReference _control;
    private ElementReference _progress;
    private ElementReference _remove;
    private ElementReference _confirmText;
    private ElementReference _removing;
    private bool _wasConfirming;
    private bool _wasRemoving;
    private bool _focusConfirm;
    private bool _focusRemoving;
    private bool _focusRemove;
    // One per offerable Role at most (Admin, Member, Viewer); the first takes focus when the picker opens.
    private readonly ElementReference[] _options = new ElementReference[3];
    private string? _chosen;
    private string? _chooseMessage;
    private bool _wasPicking;
    private bool _wasChanging;
    private bool _focusOption;
    private bool _focusProgress;
    private bool _focusControl;
    private int _focusRequestsSeen;

    /// <summary>The Membership, as the list answered it.</summary>
    [Parameter]
    [EditorRequired]
    public MembershipResponse Membership { get; set; } = new(Guid.Empty, string.Empty, string.Empty, string.Empty, IsYou: false, InSpaceNow: false);

    /// <summary>Its label: the display name, with a discriminator on a collision (AC3).</summary>
    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The viewer's own Role in this Space, as its stable code.</summary>
    [Parameter]
    [EditorRequired]
    public string ViewerRole { get; set; } = string.Empty;

    /// <summary>Whether its picker is open.</summary>
    [Parameter]
    public bool Picking { get; set; }

    /// <summary>Whether its change is with the server.</summary>
    [Parameter]
    public bool Changing { get; set; }

    /// <summary>The words for its refused or unsent change, or <c>null</c>.</summary>
    [Parameter]
    public string? Refusal { get; set; }

    /// <summary>Bumped by the section to move focus to this row's Change Role (UX-DR39).</summary>
    [Parameter]
    public int FocusRequest { get; set; }

    /// <summary>Raised by Change Role, with the Membership's id.</summary>
    [Parameter]
    public EventCallback<Guid> OnAsk { get; set; }

    /// <summary>Raised by Change with a Role chosen: the Membership's id and the Role's code.</summary>
    [Parameter]
    public EventCallback<(Guid MembershipId, string Role)> OnChange { get; set; }

    /// <summary>Raised by Cancel, or by Esc in the picker.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Whether its removal is being confirmed.</summary>
    [Parameter]
    public bool ConfirmingRemoval { get; set; }

    /// <summary>Whether the person is in this Space now, as the confirm's fresh read answered; <c>null</c> until it has.</summary>
    [Parameter]
    public bool? InSpaceNow { get; set; }

    /// <summary>Whether its removal is with the server.</summary>
    [Parameter]
    public bool Removing { get; set; }

    /// <summary>Raised by Remove, with the Membership's id: the section opens the confirm and reads the row afresh.</summary>
    [Parameter]
    public EventCallback<Guid> OnAskToRemove { get; set; }

    /// <summary>Raised by the confirm's Remove, with the Membership's id.</summary>
    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    /// <summary>Raised by the confirm's Cancel, or by Esc in it.</summary>
    [Parameter]
    public EventCallback OnCancelRemoval { get; set; }

    private IReadOnlyList<string> Offered => MembershipCapabilities.OfferableRoles(ViewerRole, Membership.Role);

    private IEnumerable<(string RoleCode, int At)> Options => Offered.Select((roleCode, at) => (roleCode, at));

    // Something already replaces the row's controls: the picker, the confirm, or a change or removal in flight.
    private bool Busy => Picking || Changing || ConfirmingRemoval || Removing;

    private bool ShowsControl => !Busy && Offered.Count > 0 && !Membership.IsYou;

    private bool ShowsRemove => !Busy && MembershipCapabilities.Removable(ViewerRole, Membership.Role, Membership.IsYou);

    private string RemoveName => string.Format(CultureInfo.CurrentCulture, Localizer["MembershipRemoveName"], Label);

    private string RemoveQuestion => string.Format(CultureInfo.CurrentCulture, Localizer["MembershipRemoveQuestion"], Label);

    private string? LiveSentence => InSpaceNow switch
    {
        true => string.Format(CultureInfo.CurrentCulture, Localizer["MembershipRemoveInSpaceNow"], Label),
        false => string.Format(CultureInfo.CurrentCulture, Localizer["MembershipRemoveNotInSpaceNow"], Label),
        null => null,
    };

    private string NameId => $"membership-{Membership.Id:N}";

    private string Legend => string.Format(
        CultureInfo.CurrentCulture,
        Localizer["MembershipChangeLegend"],
        Label,
        Localizer[RoleCopy.NameKey(Membership.Role)]);

    /// <summary>
    /// The picker opening takes focus to its first option, with nothing checked; the change going out takes focus to the
    /// status line that replaces it; a new request from the section takes focus to Change Role.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Picking && !_wasPicking)
        {
            _chosen = null;
            _chooseMessage = null;
            _focusOption = true;
        }

        if (Changing && !_wasChanging)
        {
            _focusProgress = true;
        }

        if (ConfirmingRemoval && !_wasConfirming)
        {
            _focusConfirm = true;
        }

        if (Removing && !_wasRemoving)
        {
            _focusRemoving = true;
        }

        _wasPicking = Picking;
        _wasChanging = Changing;
        _wasConfirming = ConfirmingRemoval;
        _wasRemoving = Removing;

        if (FocusRequest != _focusRequestsSeen)
        {
            _focusRequestsSeen = FocusRequest;
            _focusControl = FocusRequest > 0;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FocusChangeAsync();
        await FocusRemovalAsync();

        // Spent on the first render it could apply to, so a stale request cannot pull focus on a later, unrelated render.
        if (_focusControl && !Busy)
        {
            _focusControl = false;
            await FocusFirstControlAsync();
        }
    }

    private async Task FocusChangeAsync()
    {
        if (_focusProgress && Changing)
        {
            _focusProgress = false;
            await _progress.FocusAsync();
        }

        if (_focusOption && Picking)
        {
            _focusOption = false;
            await _options[0].FocusAsync();
        }
    }

    private async Task FocusRemovalAsync()
    {
        if (_focusRemoving && Removing)
        {
            _focusRemoving = false;
            await _removing.FocusAsync();
        }

        if (_focusConfirm && ConfirmingRemoval)
        {
            _focusConfirm = false;
            await _confirmText.FocusAsync();
        }

        if (_focusRemove && !Busy)
        {
            _focusRemove = false;

            if (ShowsRemove)
            {
                await _remove.FocusAsync();
            }
        }
    }

    /// <summary>
    /// The row's first control: Change Role where it offers one, else Remove; nothing when it offers neither.
    /// </summary>
    private async Task FocusFirstControlAsync()
    {
        if (ShowsControl)
        {
            await _control.FocusAsync();
            return;
        }

        if (ShowsRemove)
        {
            await _remove.FocusAsync();
        }
    }

    private Task AskAsync() => OnAsk.InvokeAsync(Membership.Id);

    private void Choose(ChangeEventArgs args)
    {
        _chosen = args.Value?.ToString();
        _chooseMessage = null;
    }

    private Task ChangeAsync()
    {
        if (_chosen is not { } chosen)
        {
            _chooseMessage = Localizer["MembershipRoleRequired"];
            return Task.CompletedTask;
        }

        return OnChange.InvokeAsync((Membership.Id, chosen));
    }

    /// <summary>Cancel, or Esc in the picker: nothing is sent, and focus returns to the row's Change Role.</summary>
    private Task CancelAsync()
    {
        _focusControl = true;

        return OnCancel.InvokeAsync();
    }

    private Task PickerKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CancelAsync() : Task.CompletedTask;

    private Task AskToRemoveAsync() => OnAskToRemove.InvokeAsync(Membership.Id);

    private Task RemoveAsync() => Removing ? Task.CompletedTask : OnRemove.InvokeAsync(Membership.Id);

    /// <summary>Cancel, or Esc in the confirm: nothing is sent, and focus returns to the row's Remove.</summary>
    private Task CancelRemovalAsync()
    {
        _focusRemove = true;

        return OnCancelRemoval.InvokeAsync();
    }

    private Task ConfirmKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CancelRemovalAsync() : Task.CompletedTask;
}
