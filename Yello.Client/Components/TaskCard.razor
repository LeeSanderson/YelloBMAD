@using System.Globalization
@using Yello.Client.Spaces
@using Yello.Contracts.Labels
@using Yello.Contracts.Tasks

@inject IStringLocalizer<ClientCopy> Localizer

@*
    ONE TASK ON THE BOARD - stories 2.2, 2.3 and 2.6; UX-DR8, UX-DR21, UX-DR24; DESIGN.md:137-144, :389-453.

    THE TITLE IS THE CARD'S CONTENT. A metadata row in monospace sits beneath it: the Task's Labels (story 2.4) -
    at most three chips, in the server's order, then "+N" - and the due date when there is one (story 2.3), in the
    viewer's own locale and zone (UX-DR42); the Assignee (4.6) and Presence (Epic 7) join it later. The row wraps
    before it ever scrolls sideways (UX-DR8, UX-DR41). No placeholder, no count beyond "+N", no badge, no streak.

    "+N" IS TEXT, NOT A CONTROL (story 2.4, open question 5): the panel the title opens shows every Label. Its
    accessible name says what it counts.

    THE TITLE is a native button that opens the Task detail panel (story 2.3, open question 7 (a)), named by the title
    and carrying data-task-id so the panel can return focus to it. Every Role opens it - a Viewer reads the Task there
    (EXPERIENCE.md:199).

    THE ACTIONS CONTROL (story 2.6, open question 6 (a)) - for a Role that can move Tasks only, absent otherwise, never
    disabled (UX-DR27). Always rendered, never revealed on hover (UX-DR21), at every breakpoint. It opens the card's
    menu - Open and Move - which the Board draws inside the card; so do a right-click on the card (the contextmenu
    event), the platform context-menu key and Shift+F10 on the card. Enter on the title still opens the Task. For a
    Viewer the card carries no handler at all, and the browser's own context menu is left alone. The card carries no
    shadow, declared explicitly in components.css so nobody adds one back.

    ONE ROVING TAB STOP FOR THE WHOLE BOARD (story 2.8, open questions 1 (a)-3 (a)): only the ACTIVE card's title - and,
    for a mover, its actions control after it - is in the tab order (tabindex 0); every other card's are -1, reached by the
    arrows (js/board-keys.js), by pointer and by the screen reader's virtual cursor. The list item states its position and
    the column's true total (aria-posinset, aria-setsize; AD-29). A Task picked up by the keyboard stays in its slot,
    marked task-card--carried (open question 12 (a)), while the drop zone marks where it would land.

    THE WHOLE CARD IS THE DRAG HANDLE (story 2.7, open question 4 (a)) for a Role that can move Tasks: it renders
    task-card--movable, which the Board's drag (js/board-drag.js) listens for and which gives it the grab cursor and its
    touch behaviour - the actions control and an open menu or picker are never a handle. No separate grip. A press that
    never moves is still a click on the title. While dragged the card renders task-card--lifted - the one shadow in the
    product - and once dropped or returned task-card--settled. A Viewer's card is none of these: no drag at all, not a
    disabled one (UX-DR27).
*@

<li class="@CardClass"
    aria-posinset="@Position"
    aria-setsize="@SetSize"
    @oncontextmenu="ContextMenuHandler"
    @oncontextmenu:preventDefault="@CanMove"
    @onkeydown="KeyDownHandler">
    @if (CanMove)
    {
        <div class="task-card__head">
            <button type="button" class="task-card__open" data-task-id="@TaskId" tabindex="@TabIndex" @onclick="OpenAsync" @ref="_open">
                <span class="type-task-title task-card__title">@Item.Title</span>
            </button>
            <button type="button"
                    class="task-card__actions"
                    tabindex="@TabIndex"
                    aria-label="@string.Format(CultureInfo.CurrentCulture, Localizer["TaskActions"], Item.Title)"
                    aria-haspopup="menu"
                    aria-expanded="@(MenuOpen ? "true" : "false")"
                    @onclick="ToggleMenuAsync"
                    @ref="_actions">
                <svg class="task-card__actions-icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16"><circle cx="3" cy="8" r="1.5" /><circle cx="8" cy="8" r="1.5" /><circle cx="13" cy="8" r="1.5" /></svg>
            </button>
        </div>
    }

    @if (!CanMove)
    {
        <button type="button" class="task-card__open" data-task-id="@TaskId" tabindex="@TabIndex" @onclick="OpenAsync" @ref="_open">
            <span class="type-task-title task-card__title">@Item.Title</span>
        </button>
    }

    <div class="type-meta task-card__meta">
        @foreach (var label in ShownLabels)
        {
            <LabelChip @key="label.Id" Name="@label.Name" Colour="@label.Colour" />
        }

        @if (MoreLabels > 0)
        {
            <span class="label-more">
                <span aria-hidden="true">@string.Format(CultureInfo.CurrentCulture, Localizer["LabelsMore"], MoreLabels)</span>
                <span class="visually-hidden">@string.Format(CultureInfo.CurrentCulture, Localizer["LabelsMoreName"], MoreLabels)</span>
            </span>
        }

        @if (DueText is { } due)
        {
            <span class="task-card__due">@due</span>
        }
    </div>

    @MenuContent
</li>

@code {
    private ElementReference _open;
    private ElementReference _actions;
    private int _focusRequestsSeen;
    private int _focusActionsRequestsSeen;

    /// <summary>The Task, as the Board's replica shows it now.</summary>
    [Parameter]
    [EditorRequired]
    public TaskResponse Item { get; set; }

    /// <summary>The Space's Labels by id, so the card can name the ones it carries (story 2.4).</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, LabelResponse> Labels { get; set; } = new Dictionary<Guid, LabelResponse>();

    /// <summary>Raised with the Task's id when the card is opened.</summary>
    [Parameter]
    public EventCallback<Guid> OnOpen { get; set; }

    /// <summary>
    /// Bumped by the Board to return focus to this card's title - when the panel it opened closes, or when the card was
    /// moved from its own menu. Zero for every card but the one being returned to.
    /// </summary>
    [Parameter]
    public int FocusRequest { get; set; }

    /// <summary>
    /// Whether this card's title takes focus when it is first drawn: the card just moved from its own menu into another
    /// column, where the Board draws it afresh (story 2.6, open question 9). The Board spends it after one render.
    /// </summary>
    [Parameter]
    public bool FocusOnArrival { get; set; }

    /// <summary>Whether the Role held may move Tasks: the actions control and the card's menu exist (story 2.6).</summary>
    [Parameter]
    public bool CanMove { get; set; }

    /// <summary>Whether the card's menu - or the Move picker it led to - is open on this card.</summary>
    [Parameter]
    public bool MenuOpen { get; set; }

    /// <summary>Raised with the Task's id when the card's menu is asked for, by any of its routes.</summary>
    [Parameter]
    public EventCallback<Guid> OnMenu { get; set; }

    /// <summary>Raised when Esc is pressed on the card while its menu is open.</summary>
    [Parameter]
    public EventCallback OnMenuClose { get; set; }

    /// <summary>The open menu or picker, drawn by the Board inside this card; <c>null</c> when none is.</summary>
    [Parameter]
    public RenderFragment? MenuContent { get; set; }

    /// <summary>Bumped by the Board to return focus to this card's actions control - when its menu closes.</summary>
    [Parameter]
    public int FocusActionsRequest { get; set; }

    /// <summary>Whether this is the card a move just placed: only its reflow is animated (UX-DR6).</summary>
    [Parameter]
    public bool Moved { get; set; }

    /// <summary>Whether the card is being dragged: drawn lifted (story 2.7, UX-DR4).</summary>
    [Parameter]
    public bool Lifted { get; set; }

    /// <summary>Whether this is the card a drag just dropped or returned: only its settle is animated (story 2.7, UX-DR6).</summary>
    [Parameter]
    public bool Settling { get; set; }

    /// <summary>Whether the Task is carried by the keyboard: drawn carried, in its own slot (story 2.8).</summary>
    [Parameter]
    public bool Carried { get; set; }

    /// <summary>Whether this card is the Board's one roving tab stop (story 2.8).</summary>
    [Parameter]
    public bool Active { get; set; }

    /// <summary>The card's 1-based position in its column (AD-29).</summary>
    [Parameter]
    public int Position { get; set; }

    /// <summary>The column's true total (AD-29) - never the number of cards drawn.</summary>
    [Parameter]
    public int SetSize { get; set; }

    /// <summary>The most chips a card shows before "+N" (UX-DR8).</summary>
    private const int MostChips = 3;

    private string CardClass => string.Join(' ', CardClasses());

    private IEnumerable<string> CardClasses()
    {
        yield return "task-card";

        if (CanMove)
        {
            yield return "task-card--movable";
        }

        if (Lifted)
        {
            yield return "task-card--lifted";
        }
        else if (Carried)
        {
            yield return "task-card--carried";
        }
        else if (Settling)
        {
            yield return "task-card--settled";
        }
        else if (Moved)
        {
            yield return "task-card--moved";
        }
        else
        {
            // At rest: no motion.
        }
    }

    // In the server's order (by name, then id); an id this tab does not hold a Label for is not drawn.
    private List<LabelResponse> CarriedLabels => [.. Item.LabelIds.Select(id => Labels.GetValueOrDefault(id)).OfType<LabelResponse>()];

    private IEnumerable<LabelResponse> ShownLabels => CarriedLabels.Take(MostChips);

    private int MoreLabels => Math.Max(0, CarriedLabels.Count - MostChips);

    private string? DueText =>
        Item.DueDate is { } due
            ? string.Format(CultureInfo.CurrentCulture, Localizer["TaskDue"], TaskDates.DayAndMonth(due))
            : null;

    private string TaskId => Item.Id.ToString("D", CultureInfo.InvariantCulture);

    // Blazor renders every tabindex; the keyboard module never writes one.
    private string TabIndex => Active ? "0" : "-1";

    // For a Role that cannot move Tasks the card carries no handler: the browser's own context menu is left alone.
    private EventCallback<MouseEventArgs> ContextMenuHandler =>
        CanMove ? EventCallback.Factory.Create<MouseEventArgs>(this, OpenMenuAsync) : default;

    private EventCallback<KeyboardEventArgs> KeyDownHandler =>
        CanMove ? EventCallback.Factory.Create<KeyboardEventArgs>(this, CardKeyDownAsync) : default;

    /// <summary>
    /// Every input the card draws, as it was drawn last (story 2.9, open question 12 (a)).
    /// </summary>
    private CardInputs? _drawn;

    /// <summary>
    /// Draws again only when something it draws has changed (story 2.9, AC14, open question 12 (a)). The card's event
    /// callbacks and its Task are complex parameters, so without this every render of the Board re-rendered every card - at
    /// 5,000 loaded cards a keyboard step cost about 230 ms. An open menu or picker is always drawn again: its fragment is
    /// the Board's own state.
    /// </summary>
    /// <returns>Whether the card renders.</returns>
    protected override bool ShouldRender()
    {
        var inputs = new CardInputs(
            Item, Labels, FocusRequest, FocusOnArrival, CanMove, MenuOpen, FocusActionsRequest, Moved, Lifted, Settling, Carried, Active, Position, SetSize);

        if (MenuContent is null && inputs == _drawn)
        {
            return false;
        }

        _drawn = inputs;
        return true;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A card created after the request was made - moved to another column - takes the count as already seen: only
        // a request made while it is on the Board moves focus to it, never one left over from an earlier close while a
        // panel is open over it. A card the Board draws afresh because it was just moved from its own menu takes the
        // focus it arrived with instead (story 2.6), once.
        if (firstRender)
        {
            _focusRequestsSeen = FocusRequest;
            _focusActionsRequestsSeen = FocusActionsRequest;

            if (FocusOnArrival)
            {
                await _open.FocusAsync();
            }

            return;
        }

        if (FocusActionsRequest != _focusActionsRequestsSeen)
        {
            _focusActionsRequestsSeen = FocusActionsRequest;

            if (FocusActionsRequest > 0 && CanMove)
            {
                await _actions.FocusAsync();
            }
        }

        if (FocusRequest == _focusRequestsSeen)
        {
            return;
        }

        _focusRequestsSeen = FocusRequest;

        if (FocusRequest > 0)
        {
            await _open.FocusAsync();
        }
    }

    private Task OpenAsync() => OnOpen.InvokeAsync(Item.Id);

    // A right-click, the context-menu key or Shift+F10 inside an open menu or picker leaves it as it is - never back to the
    // menu's first step.
    private Task OpenMenuAsync() => MenuOpen ? Task.CompletedTask : OnMenu.InvokeAsync(Item.Id);

    // The actions control says aria-expanded, so it closes what it opened (focus returns to it).
    private Task ToggleMenuAsync() => MenuOpen ? OnMenuClose.InvokeAsync() : OnMenu.InvokeAsync(Item.Id);

    /// <summary>
    /// The platform's context-menu key and Shift+F10 open the card's menu (UX-DR24); Esc closes it while it is open. Every
    /// other key is the card's controls' own.
    /// </summary>
    private Task CardKeyDownAsync(KeyboardEventArgs args) => args switch
    {
        { Key: "ContextMenu" } or { Key: "F10", ShiftKey: true } => OpenMenuAsync(),
        { Key: "Escape" } when MenuOpen => OnMenuClose.InvokeAsync(),
        _ => Task.CompletedTask,
    };

    /// <summary>
    /// What a card draws, compared by value: the Task by record equality (a new Label list is a new value).
    /// </summary>
    private sealed record CardInputs(
        TaskResponse Item,
        IReadOnlyDictionary<Guid, LabelResponse> Labels,
        int FocusRequest,
        bool FocusOnArrival,
        bool CanMove,
        bool MenuOpen,
        int FocusActionsRequest,
        bool Moved,
        bool Lifted,
        bool Settling,
        bool Carried,
        bool Active,
        int Position,
        int SetSize);
}
