@using Yello.Contracts.Labels

@*
    ONE LABEL IN THE TASK DETAIL PANEL'S LABEL PICKER - story 2.4, UX-DR11. The multi-select sibling of PickerOption:
    an option of the in-panel listbox (aria-multiselectable), selected exactly when the Task carries the Label, so
    nothing is pre-selected that is not already applied. Choosing one - click, Enter or Space - toggles it and commits
    the Task's whole new set at once (open question 1 (a)); there is nothing to confirm. The swatch is decoration: the
    option's name is its text, and nothing depends on colour (UX-DR7). One tab stop per picker (story 2.8, AC15, open
    question 7 (a)): only the Active option is in the tab order; ↑/↓ (wrapping), Home and End move focus between options
    (js/board-keys.js), focusing one never toggles it, and Space toggles without scrolling the page.
*@

<li class="picker__option label-option"
    role="option"
    tabindex="@(Active ? "0" : "-1")"
    aria-selected="@(Selected ? "true" : "false")"
    @onclick="ToggleAsync"
    @onfocus="OnFocused"
    @onkeydown="KeyDownAsync"
    @ref="_element"><span class="label-swatch label-chip--@ColourClass" aria-hidden="true"></span>@Label.Name</li>

@code {
    private ElementReference _element;

    /// <summary>The Label this option offers.</summary>
    [Parameter]
    [EditorRequired]
    public LabelResponse Label { get; set; } = new(Guid.Empty, string.Empty, string.Empty);

    /// <summary>Whether the Task carries it now.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Whether this option is its picker's one tab stop (story 2.8).</summary>
    [Parameter]
    public bool Active { get; set; }

    /// <summary>Raised when the option takes focus, so its picker makes it the tab stop.</summary>
    [Parameter]
    public EventCallback OnFocused { get; set; }

    /// <summary>Raised with the Label's id when it is toggled.</summary>
    [Parameter]
    public EventCallback<Guid> OnToggle { get; set; }

    private string ColourClass => LabelColours.Keys.Contains(Label.Colour, StringComparer.Ordinal) ? Label.Colour : "unknown";

    /// <summary>
    /// Moves focus to this option - the panel's focus trap sends Shift+Tab from its start here when this is the last.
    /// </summary>
    /// <returns>A task.</returns>
    public ValueTask FocusAsync() => _element.FocusAsync();

    private Task ToggleAsync() => OnToggle.InvokeAsync(Label.Id);

    private Task KeyDownAsync(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? ToggleAsync() : Task.CompletedTask;
}
