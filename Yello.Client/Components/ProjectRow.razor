@using System.Globalization
@using Yello.Contracts.Projects

@inject IStringLocalizer<ClientCopy> Localizer

@*
    ONE PROJECT IN THE LIST - story 2.1, AC3; UX-DR26, UX-DR27, UX-DR33.

    Its name as a link to its Board (story 2.2; 2.1 Q10): the link text is the name, the address holds ids
    only (UX-DR33). For a Role that may rename it, an explicit "Rename" control - never hover-only. Renaming opens an inline field with explicit Rename
    and Cancel; Esc cancels. For a Role that may not, the control is absent, not disabled.

    DELETE PROJECT (story 2.5, AC2, AC12; UX-DR12, UX-DR26, UX-DR36; open question 1 (a)): beside Rename, for the same
    Roles. It asks first, IN PLACE: once the list has been read again for the Project's true Task count (AD-29), the
    row's content is replaced by the confirm naming the Project and the count - "It holds no Tasks." when there are none,
    the friction and the reassurance being one sentence - and saying it cannot be undone, with the danger action and
    Cancel; focus moves to Cancel. Esc or Cancel restores the row with focus on "Delete Project". Not optimistic: the row
    stays until the server agrees. While the count or the deletion is with the server the control is aria-busy, never
    disabled.
*@

<li class="project-list__row">
    @if (Confirming)
    {
        <div class="destructive-confirm project-list__confirm" @onkeydown="ConfirmKeyDownAsync">
            <p class="project-list__warning">
                <span>@string.Format(CultureInfo.CurrentCulture, Localizer["DeleteQuestion"], Project.Name)</span>
                <span>@CountSentence</span>
                <span>@Localizer["DeleteCannotBeUndone"]</span>
            </p>
            <button type="button" class="button-danger" aria-busy="@(Deleting ? "true" : null)" @onclick="DeleteAsync">@Localizer["ProjectDelete"]</button>
            <button type="button" class="button-secondary" @onclick="CancelDeleteAsync" @ref="_cancel">@Localizer["DeleteCancel"]</button>
        </div>
    }

    @if (Renaming)
    {
        <form class="project-rename" @onsubmit="CommitAsync" @onkeydown="KeyDownAsync" novalidate>
            <FormField FieldId="@($"project-rename-{Project.Id:N}")"
                       FieldName="@FieldName"
                       Label="@Localizer["ProjectNameLabel"]"
                       Value="@Name"
                       ValueChanged="OnNameChanged"
                       Message="@Message"
                       Invalid="@(Message is not null)"
                       FocusOnFirstRender="true" />

            <div class="project-rename__actions">
                <PrimaryButton>@Localizer["ProjectRename"]</PrimaryButton>
                <button type="button" class="button-secondary" @onclick="OnCancel">@Localizer["ProjectCancel"]</button>
            </div>
        </form>
    }

    @if (!Renaming && !Confirming)
    {
        <a class="project-list__name" href="@ClientRoutes.Board(SpaceId, Project.Id)">@Project.Name</a>
    }

    @if (!Renaming && !Confirming && CanManage)
    {
        <button type="button" class="button-secondary" @onclick="StartAsync">@Localizer["ProjectRename"]</button>
        <button type="button" class="button-secondary" aria-busy="@(Counting ? "true" : null)" @onclick="AskToDeleteAsync" @ref="_delete">@Localizer["ProjectDelete"]</button>
    }

    @if (Refusal is { } refusal)
    {
        <p class="project-list__refusal" role="status">@refusal</p>
    }
</li>

@code {
    /// <summary>The Space the Project is in, for its Board's address.</summary>
    [Parameter]
    [EditorRequired]
    public Guid SpaceId { get; set; }

    /// <summary>The Project.</summary>
    [Parameter]
    [EditorRequired]
    public ProjectResponse Project { get; set; } = new(Guid.Empty, string.Empty, default);

    /// <summary>Whether the Role may rename and delete it. When not, both controls are absent.</summary>
    [Parameter]
    public bool CanManage { get; set; }

    /// <summary>Whether its rename field is open.</summary>
    [Parameter]
    public bool Renaming { get; set; }

    /// <summary>The name in the rename field.</summary>
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>The field's message - why the name typed is refused - or <c>null</c>.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Why the last rename was refused and reverted, or <c>null</c>.</summary>
    [Parameter]
    public string? Refusal { get; set; }

    /// <summary>A field name no browser's autofill would match (UX-DR33).</summary>
    [Parameter]
    public string FieldName { get; set; } = string.Empty;

    /// <summary>Raised when the row's Rename control is used.</summary>
    [Parameter]
    public EventCallback<ProjectResponse> OnStart { get; set; }

    /// <summary>Raised on every keystroke in the rename field.</summary>
    [Parameter]
    public EventCallback<string> OnNameChanged { get; set; }

    /// <summary>Raised when the rename is committed.</summary>
    [Parameter]
    public EventCallback<ProjectResponse> OnCommit { get; set; }

    /// <summary>Raised when the rename is cancelled, by its control or by Esc.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Whether its delete confirm is open (story 2.5).</summary>
    [Parameter]
    public bool Confirming { get; set; }

    /// <summary>Whether its true Task count is being read before the confirm opens (story 2.5).</summary>
    [Parameter]
    public bool Counting { get; set; }

    /// <summary>Whether its deletion is with the server (story 2.5).</summary>
    [Parameter]
    public bool Deleting { get; set; }

    /// <summary>Raised by the row's delete control: the list reads the count, then opens the confirm (story 2.5).</summary>
    [Parameter]
    public EventCallback<ProjectResponse> OnAskToDelete { get; set; }

    /// <summary>Raised by the confirm's danger action (story 2.5).</summary>
    [Parameter]
    public EventCallback<ProjectResponse> OnDelete { get; set; }

    /// <summary>Raised by the confirm's Cancel or by Esc in it (story 2.5).</summary>
    [Parameter]
    public EventCallback OnCancelDelete { get; set; }

    private ElementReference _delete;
    private ElementReference _cancel;
    private bool _wasConfirming;
    private bool _focusCancel;
    private bool _focusDelete;

    // The count's sentence: none, one, or many - each its own whole sentence, never concatenated (story 2.5, AC2).
    private string CountSentence => Project.TaskCount switch
    {
        0 => Localizer["ProjectHoldsNoTasks"],
        1 => Localizer["ProjectHoldsOneTask"],
        var count => string.Format(CultureInfo.CurrentCulture, Localizer["ProjectHoldsTasks"], count),
    };

    /// <summary>
    /// The confirm opening takes focus to its Cancel: neither choice is a default, and a misplaced Enter destroys nothing.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Confirming && !_wasConfirming)
        {
            _focusCancel = true;
        }

        _wasConfirming = Confirming;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCancel && Confirming)
        {
            _focusCancel = false;
            await _cancel.FocusAsync();
        }

        if (_focusDelete && !Confirming && !Renaming && CanManage)
        {
            _focusDelete = false;
            await _delete.FocusAsync();
        }
    }

    private Task StartAsync() => OnStart.InvokeAsync(Project);

    private Task AskToDeleteAsync() => Counting ? Task.CompletedTask : OnAskToDelete.InvokeAsync(Project);

    private Task DeleteAsync() => Deleting ? Task.CompletedTask : OnDelete.InvokeAsync(Project);

    /// <summary>Cancel, or Esc in the confirm: nothing is sent, and focus returns to the row's delete control.</summary>
    private Task CancelDeleteAsync()
    {
        if (Deleting)
        {
            return Task.CompletedTask;
        }

        _focusDelete = true;

        return OnCancelDelete.InvokeAsync();
    }

    private Task ConfirmKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CancelDeleteAsync() : Task.CompletedTask;

    private Task CommitAsync() => OnCommit.InvokeAsync(Project);

    private Task KeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
