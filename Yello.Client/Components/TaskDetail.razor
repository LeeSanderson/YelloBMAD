@using System.Globalization
@using Yello.Client.Spaces
@using Yello.Contracts.Labels
@using Yello.Contracts.Tasks

@inject IStringLocalizer<ClientCopy> Localizer
@inject IJSRuntime JS

@*
    THE TASK DETAIL PANEL - story 2.3. AC1-AC3, AC5-AC7, AC12-AC14; UX-DR10, UX-DR11, UX-DR12, UX-DR26,
    UX-DR27, UX-DR33, UX-DR39, UX-DR40, UX-DR42; DESIGN.md:238-244, :465-473; EXPERIENCE.md:199, :206-211, :318.

    ONE LEVEL DEEP, OVER THE BOARD, NEVER A ROUTE (open question 6 (a)). The Board renders it and owns its
    state, so it is purged with the Board; the address and the tab's title never change. Opening another card
    replaces this panel's content - it never stacks a second one.

    A MODAL DIALOG LABELLED BY ITS OWN HEADING, the Task's title. Focus moves in on open and is trapped: a
    sentinel at each end sends Tab and Shift+Tab back round. Esc closes - but the innermost meaning wins: Esc
    in a title field holding an uncommitted change reverts the field first, and Esc in the open picker
    closes the picker. On close the Board returns focus to the card that opened it.

    ATTRIBUTES, THEN DELETE: title, Status, Move, due date and - since story 2.4 - Labels, attributes above. No
    description region, no heading for one, no placeholder (AC6; FR-31 is Epic 7). No Assignee (4.6).

    MOVE (story 2.6, AC1, AC14; open questions 5 (a) and 9): a secondary button directly after the Status control, for a
    Role that can move Tasks only. It opens the Move picker in place below it - never a second dialog - which names the
    destination Status, then the position, with nothing selected; choosing a position commits, optimistically, and the
    panel stays open with focus back on Move. Esc steps the picker back, then closes it, returning focus to Move.

    DELETE TASK (story 2.5, AC1, AC11; UX-DR12, UX-DR26, UX-DR36): the panel's last control, a secondary button - the
    danger colour is spent only inside the confirm (open question 8). It asks first, IN PLACE: the panel's content is
    replaced by the confirm - still this one dialog, still trapped, never a second dialog stacked on it - which names the
    Task, says it cannot be undone, and offers the danger action and Cancel, with focus on Cancel (open question 9: a
    misplaced Enter destroys nothing). Esc or Cancel brings the content back and focus returns to "Delete Task"; a second
    Esc closes the panel. Not optimistic: while the server is asked the danger action is aria-busy (never disabled, open
    question 10) and the card stays; the Board removes it on 204. A refusal is said in the confirm's own status region.

    THE LABELS (story 2.4, AC7): the applied chips, and a "Labels" control opening a multi-select listbox in the
    panel - the Space's Labels, the applied ones selected, nothing else pre-selected (UX-DR11). Toggling one commits the
    Task's whole new set at once, optimistically, like every other attribute. A Space with no Labels says so, with a
    way to Space settings for a Role that may define them. A Viewer reads the chips as text.

    NO SAVE (AC2, UX-DR26). A title commits on Enter or when the field is left; a Status commits when it is
    chosen; a date commits when it is picked; "Clear due date" commits at once. Nothing reads "Save", and
    nothing says an edit is in flight. Every change renders at once (the Board's replica) and a refusal is
    said in the always-present region below the fields, in the client's own words for its type.

    A VIEWER OPENS IT TOO, and reads the attributes as text: no input, no picker, no clear control, no
    button but Close - absent, never disabled (UX-DR27). A Role re-read lower while the panel is open removes
    the controls in place (AC14).
*@

<div class="task-detail-layer">
    <div class="task-detail" role="dialog" aria-modal="true" aria-labelledby="@HeadingId" @onkeydown="KeyDownAsync">
        <div class="task-detail__sentinel" tabindex="0" @onfocus="FocusLastAsync"></div>

        @if (_confirming)
        {
            <div class="destructive-confirm task-detail__confirm">
                <h2 class="type-dialog-title task-detail__title" id="@HeadingId">@string.Format(CultureInfo.CurrentCulture, Localizer["DeleteQuestion"], Item.Title)</h2>
                <p class="task-detail__warning">@Localizer["DeleteCannotBeUndone"]</p>
                <div class="task-detail__confirm-actions">
                    <button type="button" class="button-danger" aria-busy="@(Deleting ? "true" : null)" @onclick="DeleteAsync" @ref="_danger">@Localizer["TaskDelete"]</button>
                    <button type="button" class="button-secondary" @onclick="CancelConfirmAsync" @ref="_cancel">@Localizer["DeleteCancel"]</button>
                </div>

                @* Present from the confirm's start, so a refusal's words are announced when they arrive. *@
                <p class="task-detail__refusal" role="status">@DeleteRefusal</p>
            </div>
        }

        @if (!_confirming)
        {
            <div class="task-detail__head">
                <h2 class="type-dialog-title task-detail__title" id="@HeadingId">@Item.Title</h2>
                <button type="button" class="button-secondary task-detail__close" @onclick="CloseAsync" @ref="_close">@Localizer["TaskDetailClose"]</button>
            </div>
        }

        @if (!_confirming && CanManage)
        {
            <div class="task-detail__field">
                <label class="form-field__label" for="@TitleId">@Localizer["TaskDetailTitleLabel"]</label>
                @* A textarea so a long title wraps rather than being cut off by its box (WCAG 1.4.12); still one line -
                   js/single-line.js stops Enter's newline and turns a pasted line break into a space. *@
                <textarea class="form-field__control task-detail__title-field"
                          id="@TitleId"
                          name="@_fieldName"
                          rows="1"
                          autocomplete="off"
                          data-single-line
                          value="@_titleDraft"
                          aria-invalid="@(_titleMessage is not null ? "true" : null)"
                          aria-describedby="@(_titleMessage is not null ? TitleMessageId : null)"
                          @oninput="TitleInput"
                          @onkeydown="TitleKeyDownAsync"
                          @onchange="TitleChangedAsync"></textarea>

                @if (_titleMessage is not null)
                {
                    <p class="form-field__message" id="@TitleMessageId">@_titleMessage</p>
                }
            </div>

            <div class="task-detail__field">
                <span class="form-field__label" id="@StatusLabelId">@Localizer["TaskDetailStatusLabel"]</span>
                <button type="button"
                        class="button-secondary task-detail__status"
                        id="@StatusButtonId"
                        aria-haspopup="listbox"
                        aria-expanded="@(_pickerOpen ? "true" : "false")"
                        aria-labelledby="@($"{StatusLabelId} {StatusButtonId}")"
                        @onclick="TogglePicker"
                        @ref="_statusButton">@StatusName</button>

                @if (_pickerOpen)
                {
                    @* In the panel, not a second dialog (open question 11): the current Status is marked as
                       current, and nothing is pre-selected as a destination (UX-DR11). *@
                    <ul class="picker" role="listbox" aria-labelledby="@StatusLabelId">
                        @foreach (var status in Statuses)
                        {
                            <PickerOption @key="status.Id"
                                          Option="@status"
                                          Current="@(status.Id == Item.StatusId)"
                                          Active="@(StatusStop == status.Id)"
                                          OnFocused="() => _activeStatus = status.Id"
                                          OnChoose="ChooseAsync" />
                        }
                    </ul>
                }
            </div>

            <div class="task-detail__field">
                <button type="button"
                        class="button-secondary task-detail__move"
                        aria-haspopup="listbox"
                        aria-expanded="@(_moveOpen ? "true" : "false")"
                        @onclick="ToggleMove"
                        @ref="_moveButton">@Localizer["TaskMove"]</button>

                @if (_moveOpen)
                {
                    <MovePicker Columns="@MoveColumns" Item="@Item" OnChoose="MoveChosenAsync" OnDismiss="MoveDismissed" />
                }
            </div>

            <div class="task-detail__field">
                <label class="form-field__label" for="@DueDateId">@Localizer["TaskDetailDueDateLabel"]</label>
                <div class="task-detail__due">
                    <input class="form-field__control task-detail__date"
                           id="@DueDateId"
                           type="date"
                           value="@TaskDates.InputValue(Item.DueDate)"
                           @onchange="DueDateChangedAsync"
                           @ref="_dueDate" />

                    @if (Item.DueDate is not null)
                    {
                        <button type="button" class="button-secondary" @onclick="ClearDueDateAsync" @ref="_clear">@Localizer["TaskDueDateClear"]</button>
                    }
                </div>
            </div>

            <div class="task-detail__field">
                <button type="button"
                        class="button-secondary task-detail__labels-control"
                        id="@LabelsButtonId"
                        aria-haspopup="listbox"
                        aria-expanded="@(_labelPickerOpen ? "true" : "false")"
                        @onclick="ToggleLabelPicker"
                        @ref="_labelsButton">@Localizer["LabelsControl"]</button>

                @if (AppliedLabels.Count > 0)
                {
                    <div class="task-detail__labels">
                        @foreach (var label in AppliedLabels)
                        {
                            <LabelChip @key="label.Id" Name="@label.Name" Colour="@label.Colour" />
                        }
                    </div>
                }

                @if (_labelPickerOpen && SpaceLabels.Count > 0)
                {
                    @* In the panel, not a second dialog: selected exactly where applied (UX-DR11). *@
                    <ul class="picker" role="listbox" aria-multiselectable="true" aria-labelledby="@LabelsButtonId">
                        @foreach (var label in SpaceLabels)
                        {
                            <LabelOption @key="label.Id"
                                         Label="@label"
                                         Selected="@Item.LabelIds.Contains(label.Id)"
                                         Active="@(LabelStop == label.Id)"
                                         OnFocused="() => _activeLabel = label.Id"
                                         OnToggle="ToggleLabelAsync" />
                        }
                    </ul>
                }

                @if (_labelPickerOpen && SpaceLabels.Count == 0)
                {
                    <p class="task-detail__labels-empty">
                        @Localizer["LabelsEmpty"]

                        @if (CanManageLabels)
                        {
                            <a class="task-detail__labels-link" href="@ClientRoutes.SpaceSettings(SpaceId)">@Localizer["SpaceSettingsLink"]</a>
                        }
                    </p>
                }
            </div>
        }

        @if (!_confirming && !CanManage)
        {
            <dl class="task-detail__attributes">
                <dt class="form-field__label">@Localizer["TaskDetailStatusLabel"]</dt>
                <dd>@StatusName</dd>

                @if (Item.DueDate is { } due)
                {
                    <dt class="form-field__label">@Localizer["TaskDetailDueDateLabel"]</dt>
                    <dd>@TaskDates.FullDate(due)</dd>
                }

                @if (AppliedLabels.Count > 0)
                {
                    <dt class="form-field__label">@Localizer["LabelsControl"]</dt>
                    <dd class="task-detail__labels">
                        @foreach (var label in AppliedLabels)
                        {
                            <LabelChip @key="label.Id" Name="@label.Name" Colour="@label.Colour" />
                        }
                    </dd>
                }
            </dl>
        }

        @if (!_confirming && CanManage)
        {
            <div class="task-detail__field">
                <button type="button" class="button-secondary task-detail__delete" @onclick="AskToDeleteAsync" @ref="_delete">@Localizer["TaskDelete"]</button>
            </div>
        }

        @if (!_confirming)
        {
            @* Present from the start, so a refusal's words are announced when they arrive. *@
            <p class="task-detail__refusal" role="status">@Refusal</p>
        }

        <div class="task-detail__sentinel" tabindex="0" @onfocus="FocusFirstAsync"></div>
    </div>
</div>

@code {
    // A field name no browser's autofill would match to a saved value (UX-DR33): random per panel.
    private readonly string _fieldName = Guid.NewGuid().ToString("N");
    private readonly string _id = Guid.NewGuid().ToString("N");

    private ElementReference _close;
    private ElementReference _statusButton;
    private ElementReference _dueDate;
    private ElementReference _clear;
    private ElementReference _labelsButton;
    private ElementReference _moveButton;
    private ElementReference _delete;
    private ElementReference _danger;
    private ElementReference _cancel;

    private string _titleDraft = string.Empty;
    private string? _shownTitle;
    private string? _titleMessage;
    private bool _pickerOpen;
    private bool _escapeHandled;
    private bool _focusDueDate;
    private bool _focusStatusButton;
    private bool _labelPickerOpen;
    private bool _focusLabelsButton;
    private bool _confirming;
    private bool _focusCancel;
    private bool _focusDelete;
    private bool _moveOpen;
    private bool _focusMoveButton;

    // Each picker's one tab stop (story 2.8, AC15): the option focus was last on, or the first.
    private Guid? _activeStatus;
    private Guid? _activeLabel;

    /// <summary>The Task, as the Board's replica shows it now.</summary>
    [Parameter]
    [EditorRequired]
    public TaskResponse Item { get; set; }

    /// <summary>The Project's effective set: the Board's columns, in order.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<TaskStatusOption> Statuses { get; set; } = [];

    /// <summary>The Space the Task is in, for the way to Space settings when it has no Labels.</summary>
    [Parameter]
    public Guid SpaceId { get; set; }

    /// <summary>The Space's Labels, in the server's order (by name, then id). Story 2.4.</summary>
    [Parameter]
    public IReadOnlyList<LabelResponse> SpaceLabels { get; set; } = [];

    /// <summary>Whether the Role held may define Labels, so an empty picker offers the way to Space settings.</summary>
    [Parameter]
    public bool CanManageLabels { get; set; }

    /// <summary>Whether the Role held may edit the Task; otherwise its attributes render as text.</summary>
    [Parameter]
    public bool CanManage { get; set; }

    /// <summary>The words for the last refused edit, or <c>null</c>.</summary>
    [Parameter]
    public string? Refusal { get; set; }

    /// <summary>Raised with a new title, already checked against the title rule.</summary>
    [Parameter]
    public EventCallback<string> OnTitle { get; set; }

    /// <summary>Raised with a newly chosen Status.</summary>
    [Parameter]
    public EventCallback<Guid> OnStatus { get; set; }

    /// <summary>Raised with a new due date, or <c>null</c> to clear it.</summary>
    [Parameter]
    public EventCallback<DateTimeOffset?> OnDueDate { get; set; }

    /// <summary>The Board's columns, with the Tasks each holds, for the Move picker (story 2.6).</summary>
    [Parameter]
    public IReadOnlyList<MoveColumn> MoveColumns { get; set; } = [];

    /// <summary>Raised with the destination when a position is chosen in the Move picker (story 2.6).</summary>
    [Parameter]
    public EventCallback<MoveChoice> OnMove { get; set; }

    /// <summary>Raised with the Task's whole new set of Labels, in the server's order, when one is toggled.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<Guid>> OnLabels { get; set; }

    /// <summary>Raised when the panel is closed, by Close or by Esc.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Raised with <c>true</c> when the delete confirm opens and <c>false</c> when it is cancelled, so the Board clears
    /// words that belonged to the content it replaced (story 2.5).
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnConfirmToggled { get; set; }

    /// <summary>Raised by the confirm's danger action: the Board asks the server to delete the Task (story 2.5).</summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>Whether the Task's deletion is on its way to the server: the danger action is busy (story 2.5).</summary>
    [Parameter]
    public bool Deleting { get; set; }

    /// <summary>
    /// The words for the deletion's own refusal or no answer, said in the confirm's status region - kept apart from
    /// <see cref="Refusal"/>, so an edit answering while the confirm is open is never read as the deletion refused.
    /// </summary>
    [Parameter]
    public string? DeleteRefusal { get; set; }

    private string HeadingId => "task-detail-heading-" + _id;

    private string TitleId => "task-detail-title-" + _id;

    private string TitleMessageId => TitleId + "-message";

    private string StatusLabelId => "task-detail-status-label-" + _id;

    private string StatusButtonId => "task-detail-status-" + _id;

    private string DueDateId => "task-detail-due-" + _id;

    private string LabelsButtonId => "task-detail-labels-" + _id;

    // The Labels the Task carries, in its own (server) order; an id this tab holds no Label for is not drawn.
    private List<LabelResponse> AppliedLabels =>
        [.. Item.LabelIds.Select(id => SpaceLabels.FirstOrDefault(label => label.Id == id)).OfType<LabelResponse>()];

    // The option that is its picker's tab stop: the one focus was last on while it is still offered, or the first.
    private Guid? StatusStop => Statuses.Any(status => status.Id == _activeStatus) ? _activeStatus : Statuses.FirstOrDefault()?.Id;

    private Guid? LabelStop => SpaceLabels.Any(label => label.Id == _activeLabel) ? _activeLabel : SpaceLabels.FirstOrDefault()?.Id;

    private string StatusName => Statuses.FirstOrDefault(status => status.Id == Item.StatusId)?.Name ?? string.Empty;

    /// <summary>
    /// The field follows the Task's title whenever the replica's title changes - a commit, an admission or a
    /// revert - and otherwise keeps what is being typed.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (!string.Equals(_shownTitle, Item.Title, StringComparison.Ordinal))
        {
            _shownTitle = Item.Title;
            _titleDraft = Item.Title;
        }

        if (!CanManage)
        {
            _pickerOpen = false;
            _labelPickerOpen = false;
            _moveOpen = false;
            _titleMessage = null;
            _confirming = false;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _close.FocusAsync();
            await InstallSingleLineAsync();
            return;
        }

        if (_focusDueDate)
        {
            _focusDueDate = false;
            await _dueDate.FocusAsync();
        }

        await FocusPickerControlAsync();

        // Each request is spent whether or not its control is drawn, so focus never goes to an element that is not there.
        if (_focusCancel)
        {
            _focusCancel = false;

            if (_confirming)
            {
                await _cancel.FocusAsync();
            }
        }

        if (_focusDelete)
        {
            _focusDelete = false;

            if (!_confirming && CanManage)
            {
                await _delete.FocusAsync();
            }
        }
    }

    /// <summary>
    /// Keeps the Title field to one line on screen (js/single-line.js). A module that cannot load leaves Enter drawing a
    /// line break before it commits; the title itself stays one line, because <see cref="OneLine"/> flattens it.
    /// </summary>
    private async Task InstallSingleLineAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/single-line.js");
            await module.InvokeVoidAsync("install");
        }
        catch (Exception exception) when (exception is JSException or ObjectDisposedException or InvalidOperationException or OperationCanceledException)
        {
            // The page is going, or the module could not load: see above.
        }
    }

    /// <summary>
    /// Returns focus to the control whose picker just closed: Status, Labels or Move.
    /// </summary>
    private async Task FocusPickerControlAsync()
    {
        if (_focusStatusButton)
        {
            _focusStatusButton = false;
            await _statusButton.FocusAsync();
        }

        if (_focusLabelsButton)
        {
            _focusLabelsButton = false;
            await _labelsButton.FocusAsync();
        }

        if (_focusMoveButton)
        {
            _focusMoveButton = false;

            if (!_confirming && CanManage)
            {
                await _moveButton.FocusAsync();
            }
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    /// <summary>
    /// Esc, after any inner control has had its say: the open picker closes first; otherwise the panel does.
    /// </summary>
    private Task KeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return Task.CompletedTask;
        }

        if (_escapeHandled)
        {
            _escapeHandled = false;
            return Task.CompletedTask;
        }

        if (_confirming)
        {
            // The innermost meaning: this Esc leaves the confirm, and a second one closes the panel. While the
            // deletion is with the server it does nothing - the answer decides what the panel shows next.
            return Deleting ? Task.CompletedTask : CancelConfirmAsync();
        }

        if (_pickerOpen)
        {
            _pickerOpen = false;
            _focusStatusButton = true;
            return Task.CompletedTask;
        }

        if (_labelPickerOpen)
        {
            _labelPickerOpen = false;
            _focusLabelsButton = true;
            return Task.CompletedTask;
        }

        if (_moveOpen)
        {
            // Esc from outside the Move picker (it keeps its own keys): the picker closes first.
            MoveDismissed();
            return Task.CompletedTask;
        }

        return OnClose.InvokeAsync();
    }

    private async Task FocusFirstAsync() => await (_confirming ? _danger : _close).FocusAsync();

    /// <summary>
    /// Shift+Tab from the panel's start goes to its last control: the confirm's Cancel while it is open; for a Role that
    /// edits, the delete control (story 2.5 moved the end of the panel there from the Labels field); for a Viewer, Close.
    /// </summary>
    private async Task FocusLastAsync()
    {
        if (_confirming)
        {
            await _cancel.FocusAsync();
        }
        else if (CanManage)
        {
            await _delete.FocusAsync();
        }
        else
        {
            await _close.FocusAsync();
        }
    }

    /// <summary>
    /// The panel's delete control: the confirm replaces the panel's content, and focus moves to its Cancel (open question 9).
    /// </summary>
    private Task AskToDeleteAsync()
    {
        _pickerOpen = false;
        _labelPickerOpen = false;
        _moveOpen = false;
        _confirming = true;
        _focusCancel = true;

        return OnConfirmToggled.InvokeAsync(true);
    }

    /// <summary>
    /// Cancel, or Esc in the confirm: nothing is sent, the content returns, and focus returns to the panel's delete control.
    /// </summary>
    private Task CancelConfirmAsync()
    {
        // While the deletion is with the server its answer decides what the panel shows next, as for Esc.
        if (Deleting)
        {
            return Task.CompletedTask;
        }

        _confirming = false;
        _focusDelete = true;

        return OnConfirmToggled.InvokeAsync(false);
    }

    /// <summary>
    /// The danger action. A second press while the first is with the server is ignored - the busy state, never a
    /// disabled one (open question 10).
    /// </summary>
    private Task DeleteAsync() => Deleting ? Task.CompletedTask : OnDelete.InvokeAsync();

    private void TitleInput(ChangeEventArgs args) => _titleDraft = OneLine(args.Value);

    /// <summary>
    /// A title is one line whatever reached the textarea: a line break becomes a space.
    /// </summary>
    private static string OneLine(object? value) => (value?.ToString() ?? string.Empty).ReplaceLineEndings(" ");

    private Task TitleKeyDownAsync(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter":
                return CommitTitleAsync();

            case "Escape" when !string.Equals(_titleDraft, Item.Title, StringComparison.Ordinal):
                // The innermost meaning wins: this Esc reverts the field, and the panel stays open.
                _titleDraft = Item.Title;
                _titleMessage = null;
                _escapeHandled = true;
                return Task.CompletedTask;

            default:
                return Task.CompletedTask;
        }
    }

    private Task TitleChangedAsync(ChangeEventArgs args)
    {
        _titleDraft = OneLine(args.Value);

        return CommitTitleAsync();
    }

    private Task CommitTitleAsync()
    {
        if (string.Equals(_titleDraft.Trim(), Item.Title, StringComparison.Ordinal))
        {
            _titleMessage = null;
            return Task.CompletedTask;
        }

        if (!TaskTitleRule.IsTaskTitle(_titleDraft))
        {
            _titleMessage = Localizer["TaskTitleInvalid"];
            return Task.CompletedTask;
        }

        _titleMessage = null;

        return OnTitle.InvokeAsync(_titleDraft.Trim());
    }

    private void TogglePicker()
    {
        _pickerOpen = !_pickerOpen;
        _moveOpen = false;
    }

    private void ToggleLabelPicker()
    {
        _labelPickerOpen = !_labelPickerOpen;
        _moveOpen = false;
    }

    /// <summary>The panel's Move control: the Move picker opens in place, one picker at a time (story 2.6).</summary>
    private void ToggleMove()
    {
        _moveOpen = !_moveOpen;
        _pickerOpen = false;
        _labelPickerOpen = false;
    }

    /// <summary>Esc out of the Move picker: nothing is moved, and focus returns to Move (open question 9).</summary>
    private void MoveDismissed()
    {
        _moveOpen = false;
        _focusMoveButton = true;
    }

    /// <summary>A position chosen: the picker closes, focus returns to Move and the Board makes the move.</summary>
    private Task MoveChosenAsync(MoveChoice choice)
    {
        _moveOpen = false;
        _focusMoveButton = true;

        return OnMove.InvokeAsync(choice);
    }

    /// <summary>
    /// Toggles one Label and commits the Task's whole new set (story 2.4, open question 1 (a)), in the server's order so
    /// the card and the panel draw it as a read would. The picker stays open: several Labels are often chosen at once.
    /// A carried Label this tab's list does not hold - defined and applied elsewhere since the Board loaded - is kept,
    /// after the known ones: the whole set is sent, so leaving it out would remove a Label this person never saw.
    /// </summary>
    private Task ToggleLabelAsync(Guid labelId)
    {
        var carried = Item.LabelIds.Contains(labelId)
            ? Item.LabelIds.Where(id => id != labelId).ToHashSet()
            : Item.LabelIds.Append(labelId).ToHashSet();

        var known = SpaceLabels.Select(label => label.Id).ToHashSet();

        IReadOnlyList<Guid> next =
        [
            .. SpaceLabels.Select(label => label.Id).Where(carried.Contains),
            .. Item.LabelIds.Where(id => carried.Contains(id) && !known.Contains(id)),
        ];

        return OnLabels.InvokeAsync(next);
    }

    private Task ChooseAsync(Guid statusId)
    {
        _pickerOpen = false;
        _focusStatusButton = true;

        return statusId == Item.StatusId ? Task.CompletedTask : OnStatus.InvokeAsync(statusId);
    }

    private Task DueDateChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();

        // An empty value is a date being retyped (the browser reports any incomplete date as empty), never a
        // clear: only the panel's clear control clears. A date outside the range - a year part-way through typing -
        // is not sent either.
        if (string.IsNullOrEmpty(value) || !TaskDates.TryFromInputValue(value, out var due) || due is null || due == Item.DueDate)
        {
            return Task.CompletedTask;
        }

        return OnDueDate.InvokeAsync(due);
    }

    private Task ClearDueDateAsync()
    {
        // The control goes with the date it clears, so focus moves to the date field rather than the page.
        _focusDueDate = true;

        return OnDueDate.InvokeAsync(null);
    }
}
