@using Yello.Contracts.Labels
@using Yello.Contracts.Tasks

@inject IStringLocalizer<ClientCopy> Localizer

@*
    ONE COLUMN OF THE BOARD - story 2.2, AC4, AC5; UX-DR8, UX-DR27; DESIGN.md:149-161, :452.

    THE HEAD: the Status name in typography.column-head (uppercase by text-transform, never in the string),
    then the server's true total in the count chip - the only pill in the product, plain text, never a
    nudge - then the create affordance pushed right. The affordance is the first column's alone, and absent,
    not disabled, for a Role that lacks manage-tasks (UX-DR27).

    THE CARDS scroll within the column, never the page. Each Task appears here only if its Status is this
    column's (the Board answer places it; AC4). For a Role that can move Tasks each card carries its actions control,
    and the Board draws an open card menu or Move picker inside its card (story 2.6).

    THE DROP ZONE (story 2.7, UX-DR22): while a drag is over this column, the dashed zone is drawn at the slot it would
    land in - before the Task it would precede, counted without the dragged Task, or last - and the cards keep their order
    around it, readable mid-drag. An empty column draws its list for the zone alone, so it takes a drop. The zone is
    decoration: aria-hidden, never focusable - the live region says where a dropped Task went. The column carries its
    Status id so the drag can tell which column the pointer is over.

    FOCUS LANDS ON THE COLUMN when a card it held is deleted (story 2.5, AC11; UX-DR39; deferred-work.md:510): the
    column is the nearest surviving container, so the section takes focus programmatically (tabindex -1, never in the
    tab order) - never the page body, never an adjacent card.
*@

<section class="board-column" aria-labelledby="@HeadingId" data-status-id="@StatusIdText" tabindex="-1" @ref="_section">
    <div class="board-column__head">
        <h2 class="type-column-head board-column__name" id="@HeadingId">@Name</h2>
        <span class="type-meta column-count">@Total</span>

        @if (ShowAdd)
        {
            <button type="button" class="board-column__add" aria-label="@Localizer["TaskAdd"]" @onclick="OnAdd" @ref="_add">+</button>
        }
    </div>

    @ChildContent

    @if (Tasks.Count > 0 || DropIndex is not null)
    {
        <ul class="board-column__cards">
            @foreach (var task in Tasks)
            {
                @if (DropBefore is { } before && before == task.Id)
                {
                    <li class="type-meta drop-zone" aria-hidden="true">@Localizer["DragDropHere"]</li>
                }

                <TaskCard @key="task.Id"
                          Item="@task"
                          Labels="@Labels"
                          OnOpen="OnOpen"
                          FocusRequest="@(task.Id == FocusTaskId ? FocusRequest : 0)"
                          FocusOnArrival="@(task.Id == ArrivalTaskId)"
                          CanMove="@CanMove"
                          MenuOpen="@(task.Id == MenuTaskId)"
                          OnMenu="OnMenu"
                          OnMenuClose="OnMenuClose"
                          MenuContent="@(task.Id == MenuTaskId ? MenuContent?.Invoke(task) : null)"
                          FocusActionsRequest="@(task.Id == FocusActionsTaskId ? FocusActionsRequest : 0)"
                          Moved="@(task.Id == MovedTaskId)"
                          Settling="@(task.Id == SettlingTaskId)"
                          Lifted="@(task.Id == LiftedTaskId)" />
            }

            @if (DropLast)
            {
                <li class="type-meta drop-zone" aria-hidden="true">@Localizer["DragDropHere"]</li>
            }
        </ul>
    }
</section>

@code {
    private ElementReference _add;
    private ElementReference _section;
    private int _focusRequestsSeen;
    private int _focusColumnRequestsSeen = -1;

    /// <summary>The column's Status.</summary>
    [Parameter]
    [EditorRequired]
    public Guid StatusId { get; set; }

    /// <summary>The Status's name.</summary>
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>The server's true total for the Status - never <c>Tasks.Count</c> (AD-29).</summary>
    [Parameter]
    [EditorRequired]
    public int Total { get; set; }

    /// <summary>The Tasks placed in the column, by position key.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<TaskResponse> Tasks { get; set; } = [];

    /// <summary>Whether the head offers the create affordance.</summary>
    [Parameter]
    public bool ShowAdd { get; set; }

    /// <summary>Raised when the create affordance is used.</summary>
    [Parameter]
    public EventCallback OnAdd { get; set; }

    /// <summary>
    /// Bumped by the Board to return focus to the create affordance - after a creation field closes.
    /// </summary>
    [Parameter]
    public int FocusAddRequests { get; set; }

    /// <summary>Raised with a Task's id when its card is opened (story 2.3).</summary>
    [Parameter]
    public EventCallback<Guid> OnOpen { get; set; }

    /// <summary>The Task whose card the Board is returning focus to, if it is in this column.</summary>
    [Parameter]
    public Guid? FocusTaskId { get; set; }

    /// <summary>Bumped by the Board with each return of focus to <see cref="FocusTaskId"/>'s card.</summary>
    [Parameter]
    public int FocusRequest { get; set; }

    /// <summary>
    /// Bumped by the Board to move focus to this column - after a card it held was deleted (story 2.5). Zero for every
    /// other column.
    /// </summary>
    [Parameter]
    public int FocusColumnRequest { get; set; }

    /// <summary>Whether the Role held may move Tasks: each card carries its actions control and menu (story 2.6).</summary>
    [Parameter]
    public bool CanMove { get; set; }

    /// <summary>The Task whose card menu - or the Move picker it led to - is open, if it is in this column.</summary>
    [Parameter]
    public Guid? MenuTaskId { get; set; }

    /// <summary>Draws the open menu or picker inside its card (story 2.6).</summary>
    [Parameter]
    public Func<TaskResponse, RenderFragment?>? MenuContent { get; set; }

    /// <summary>Raised with a Task's id when its card's menu is asked for.</summary>
    [Parameter]
    public EventCallback<Guid> OnMenu { get; set; }

    /// <summary>Raised when Esc is pressed on a card whose menu is open.</summary>
    [Parameter]
    public EventCallback OnMenuClose { get; set; }

    /// <summary>The Task whose actions control the Board is returning focus to, if it is in this column.</summary>
    [Parameter]
    public Guid? FocusActionsTaskId { get; set; }

    /// <summary>Bumped by the Board with each return of focus to <see cref="FocusActionsTaskId"/>'s actions control.</summary>
    [Parameter]
    public int FocusActionsRequest { get; set; }

    /// <summary>The Task a menu move is drawing afresh in this column, whose title takes focus on arrival.</summary>
    [Parameter]
    public Guid? ArrivalTaskId { get; set; }

    /// <summary>The Task a move just placed: only its card's reflow is animated (UX-DR6).</summary>
    [Parameter]
    public Guid? MovedTaskId { get; set; }

    /// <summary>The Task a drag just dropped or returned: only its card's settle is animated (story 2.7, UX-DR6).</summary>
    [Parameter]
    public Guid? SettlingTaskId { get; set; }

    /// <summary>The Task being dragged, if any: its card is drawn lifted (story 2.7).</summary>
    [Parameter]
    public Guid? LiftedTaskId { get; set; }

    /// <summary>
    /// The drop zone's slot in this column, counted without the dragged Task, or <c>null</c> when the zone is elsewhere.
    /// </summary>
    [Parameter]
    public int? DropIndex { get; set; }

    /// <summary>The Space's Labels by id, so each card can name the Labels it carries (story 2.4).</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, LabelResponse> Labels { get; set; } = new Dictionary<Guid, LabelResponse>();

    /// <summary>What sits between the head and the cards: the open creation field, in the first column.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string HeadingId => "h" + StatusId.ToString("N", System.Globalization.CultureInfo.InvariantCulture);

    private string StatusIdText => StatusId.ToString("D", System.Globalization.CultureInfo.InvariantCulture);

    // The Task the drop zone is drawn before, or null when it is last or not in this column.
    private Guid? DropBefore { get; set; }

    private bool DropLast { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // A drop slot is counted among every Task but the dragged one.
        List<TaskResponse> others = DropIndex is null ? [] : Tasks.Where(task => task.Id != LiftedTaskId).ToList();

        DropBefore = DropIndex is { } index && index < others.Count ? others[index].Id : null;
        DropLast = DropIndex is { } last && last >= others.Count;
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A column drawn afresh notes the request it was drawn with and never acts on it, so a stale request cannot
        // steal focus (the 2.3 review fix TaskCard keeps too).
        var requested = !firstRender && FocusColumnRequest != _focusColumnRequestsSeen && FocusColumnRequest > 0;

        _focusColumnRequestsSeen = FocusColumnRequest;

        if (requested)
        {
            await _section.FocusAsync();
        }

        if (FocusAddRequests == _focusRequestsSeen)
        {
            return;
        }

        _focusRequestsSeen = FocusAddRequests;

        if (ShowAdd)
        {
            await _add.FocusAsync();
        }
    }
}
