@using Yello.Client.Spaces

@*
    ONE OPTION OF A PICKER - story 2.3, UX-DR11. An option of an in-panel listbox (open question 11): in the Status
    picker the Task's current Status is marked as current (aria-checked), and no option is ever pre-selected as a
    destination (aria-selected is always false). Choosing one - click, Enter or Space - commits it at once; there is
    nothing to confirm.

    THE MOVE PICKER (story 2.6) uses it too, marking nothing: its current Status is labelled by a note rather than
    checked, and so is its last position, so no option there is ever checked or selected.
*@

<li class="picker__option"
    role="option"
    tabindex="0"
    aria-selected="false"
    aria-checked="@Checked"
    @onclick="ChooseAsync"
    @onkeydown="KeyDownAsync">@(Note is null ? Option.Name : Option.Name + " ")@if (Note is not null)
    {
        <span class="picker__note">@Note</span>
    }</li>

@code {
    /// <summary>The Status this option offers.</summary>
    [Parameter]
    [EditorRequired]
    public TaskStatusOption Option { get; set; }

    /// <summary>Whether it is the Task's current Status.</summary>
    [Parameter]
    public bool Current { get; set; }

    /// <summary>
    /// Whether the option states <see cref="Current"/> as <c>aria-checked</c> - the Status picker's way. The Move picker
    /// labels instead (story 2.6).
    /// </summary>
    [Parameter]
    public bool MarksCurrent { get; set; } = true;

    /// <summary>A short label after the option's name - the Move picker's current Status, or its bottom position.</summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>Raised with the Status's id when it is chosen.</summary>
    [Parameter]
    public EventCallback<Guid> OnChoose { get; set; }

    // The Status picker states the current Status; the Move picker states nothing here and labels it instead.
    private string? Checked => MarksCurrent ? CurrentText : null;

    private string CurrentText => Current ? "true" : "false";

    private Task ChooseAsync() => OnChoose.InvokeAsync(Option.Id);

    private Task KeyDownAsync(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? ChooseAsync() : Task.CompletedTask;
}
