@using System.Net
@using System.Text.Json
@using Yello.Client.Refusals
@using Yello.Client.Spaces
@using Yello.Contracts
@using Yello.Contracts.Projects

@implements IDisposable

@inject IStringLocalizer<ClientCopy> Localizer
@inject HttpClient Http
@inject ActiveSpaceState ActiveSpace
@inject SpaceWrites Writes
@inject PageHeadingFocus HeadingFocus

@*
    THE ACTIVE SPACE'S PROJECTS - story 2.1. AC1-AC5, AC13; UX-DR26, UX-DR27, UX-DR31, UX-DR33, UX-DR35.

    RENDERED BY SPACE HOME ONLY AFTER THE SPACE'S OWN ANSWER, AND ITS LIST ONLY AFTER ITS OWN (UX-DR31).
    Until the list answers, the region is a busy placeholder with nothing of any Project in it.

    PURGED WITH THE SPACE. The list is registered with ActiveSpaceState's purge, which runs before the
    destination renders, and every request is issued with ActiveSpace.Token, which that purge cancels -
    so an answer about the departed Space cannot land after it.

    ABSENT, NOT DISABLED (UX-DR27). A Role without manage-projects gets no create action, no empty-state
    action and no rename control - not greyed ones. The server refuses 403 whatever is offered.

    THE EMPTY SPACE ASKS FOR NOTHING BUT A PROJECT (AC1): "No Projects yet." and one action. Nothing
    about Statuses or columns.

    NEITHER IS OPTIMISTIC. Create cannot be - the id is the server's - and rename keeps its field open,
    holding the new name, until the server answers, so a row never shows a name the server has not taken.
    Each attempt carries a fresh Idempotency-Key. The one resend after a refused anti-forgery token
    reuses it, and so does a creation of the same name sent again after an attempt that got no answer,
    because that attempt may have been applied.

    A Project name is rendered as text, never in the document title and never in a URL, and every name
    field is autocomplete="off" with a field name autofill would never match (UX-DR33).

    DELETION (story 2.5, AC2, AC3, AC12) is not optimistic either. "Delete Project" first reads the list again, so the
    confirm states each Project's true Task count as it is when the confirm opens (open question 2 (a)); one row confirms
    at a time, and opening a rename cancels it. On 204 the row leaves, "Project deleted." is announced, and focus moves to
    Space home's heading - the nearest surviving container (open question 3). The key is kept for an identical resend
    after no answer. A 404 is the Space refusal surface; any other refusal is said on the row.
*@

<p class="visually-hidden" role="status" aria-live="polite">@_announcement</p>

@if (_projects is null)
{
    <div class="project-list project-list--loading" aria-busy="true">
        <p class="visually-hidden">@Localizer["ProjectsLoading"]</p>

        @* Skeleton rows in the list's own shape, holding no text (UX-DR35 cold load, UX-DR31). *@
        <ul class="project-list__skeleton" aria-hidden="true">
            <li class="project-list__skeleton-row"></li>
            <li class="project-list__skeleton-row"></li>
            <li class="project-list__skeleton-row"></li>
        </ul>
    </div>
}

@if (_projects is not null)
{
    <div class="project-list">
        @if (_projects.Count == 0)
        {
            <p class="project-list__empty">@Localizer["ProjectsEmpty"]</p>
        }

        @if (_canManage && !_creating)
        {
            <button type="button" class="button-primary" @onclick="OpenCreate">@Localizer["ProjectCreate"]</button>
        }

        @if (_canManage && _creating)
        {
            <form class="project-create" @onsubmit="CreateAsync" @onkeydown="CreateKeyDown" novalidate>
                <FormField FieldId="project-create-name"
                           FieldName="@_createFieldName"
                           Label="@Localizer["ProjectNameLabel"]"
                           Value="@_newName"
                           ValueChanged="value => _newName = value"
                           Message="@_createMessage"
                           Invalid="@(_createMessage is not null)"
                           FocusOnFirstRender="true" />

                @if (_createRefusal is { } refusal)
                {
                    <p class="project-create__refusal" role="status">@refusal</p>
                }

                <div class="project-create__actions">
                    @if (!_submitting)
                    {
                        <PrimaryButton>@Localizer["ProjectCreateSubmit"]</PrimaryButton>
                        <button type="button" class="button-secondary" @onclick="CloseCreate">@Localizer["ProjectCancel"]</button>
                    }

                    @if (_submitting)
                    {
                        <p class="project-create__progress" role="status">@Localizer["ProjectCreating"]</p>
                    }
                </div>
            </form>
        }

        @if (_projects.Count > 0)
        {
            <ul class="project-list__items">
                @foreach (var project in _projects)
                {
                    <ProjectRow @key="project.Id"
                                SpaceId="@SpaceId"
                                Project="@project"
                                CanManage="@_canManage"
                                Renaming="@(_renaming == project.Id)"
                                Name="@_renameName"
                                Message="@_renameMessage"
                                Refusal="@(_rowRefusal?.ProjectId == project.Id ? _rowRefusal.Text : null)"
                                FieldName="@_renameFieldName"
                                OnStart="StartRename"
                                OnNameChanged="RenameNameChanged"
                                OnCommit="RenameAsync"
                                OnCancel="CancelRename"
                                Confirming="@(_confirmingDelete == project.Id)"
                                Counting="@(_counting == project.Id)"
                                Deleting="@(_deletingProject == project.Id)"
                                OnAskToDelete="AskToDeleteAsync"
                                OnDelete="DeleteAsync"
                                OnCancelDelete="CancelDelete" />
                }
            </ul>
        }
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    // Field names no browser's autofill would match to a saved value (UX-DR33): random per page.
    private readonly string _createFieldName = Guid.NewGuid().ToString("N");

    private readonly string _renameFieldName = Guid.NewGuid().ToString("N");

    private IDisposable? _purgeRegistration;

    /// <summary>
    /// Bumped by every purge. An answer that started before one is dropped when it arrives.
    /// </summary>
    private int _generation;

    private List<ProjectResponse>? _projects;
    private bool _canManage;
    private string? _announcement;

    private bool _creating;
    private bool _submitting;
    private string _newName = string.Empty;
    private string? _createMessage;
    private string? _createRefusal;
    private UnansweredCreate? _unanswered;

    private Guid? _renaming;
    private string _renameName = string.Empty;
    private string? _renameMessage;
    private bool _renameInFlight;
    private RowRefusal? _rowRefusal;

    // Story 2.5: the row whose count is being read, the row confirming, the row whose deletion is with the server, the
    // key of each deletion that got no answer, and whether focus moves to the page's heading after a deletion.
    private Guid? _counting;
    private Guid? _confirmingDelete;
    private Guid? _deletingProject;
    private readonly Dictionary<Guid, string> _deleteKeys = [];
    private bool _focusHeading;

    /// <summary>
    /// The Space whose Projects these are.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Guid SpaceId { get; set; }

    /// <summary>
    /// The Role held there, as its stable code, from the active Space's answer on this load.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public string RoleCode { get; set; } = string.Empty;

    /// <summary>
    /// Raised when the server refuses the Space itself - a <c>404</c> - so Space home renders its one
    /// refusal surface.
    /// </summary>
    [Parameter]
    public EventCallback<ProblemResponse?> OnSpaceRefused { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _purgeRegistration = ActiveSpace.RegisterPurge(Purge);

        await LoadAsync(_generation);
    }

    /// <summary>
    /// The Role is re-read on every arrival, a re-arrival in the same Space included (story 2.2, AC14), and
    /// applied in place: the list and an open form survive, and a form the Role no longer permits closes.
    /// </summary>
    protected override void OnParametersSet()
    {
        _canManage = ProjectCapabilities.PermitsManageProjects(RoleCode);

        if (!_canManage)
        {
            _creating = false;
            _renaming = null;
            _confirmingDelete = null;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHeading)
        {
            _focusHeading = false;

            if (HeadingFocus.Current is { } heading)
            {
                await heading.FocusAsync();
            }
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _generation++;
        _purgeRegistration?.Dispose();
    }

    /// <summary>
    /// The Space is being left: everything about its Projects goes, synchronously.
    /// </summary>
    private void Purge()
    {
        _generation++;
        _projects = null;
        _announcement = null;
        _creating = false;
        _submitting = false;
        _newName = string.Empty;
        _createMessage = null;
        _createRefusal = null;
        _unanswered = null;
        _renaming = null;
        _renameName = string.Empty;
        _renameMessage = null;
        _rowRefusal = null;
        _counting = null;
        _confirmingDelete = null;
        _deletingProject = null;
        _deleteKeys.Clear();
        _focusHeading = false;
    }

    private async Task LoadAsync(int generation)
    {
        var token = ActiveSpace.Token;

        try
        {
            using var response = await Http.GetAsync(new Uri(ProjectRoutes.ListIn(SpaceId), UriKind.Relative), token);

            if (generation != _generation || token.IsCancellationRequested)
            {
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var projects = await response.Content.ReadFromJsonAsync<List<ProjectResponse>>(JsonOptions, token);

                if (projects is not null && generation == _generation)
                {
                    _projects = projects;
                    _announcement = Localizer["ProjectsLoaded"];
                }

                return;
            }

            if (response.StatusCode != HttpStatusCode.Unauthorized)
            {
                await OnSpaceRefused.InvokeAsync(await ProblemOfAsync(response, token));
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The tab left this Space, or the Session ended: both purges have run.
        }
        catch (OperationCanceledException)
        {
            // The request timed out while the tab is still here: refuse rather than stay a skeleton.
            await RefuseUnlessLeftAsync(generation);
        }
        catch (HttpRequestException)
        {
            await RefuseUnlessLeftAsync(generation);
        }
        catch (JsonException)
        {
            await RefuseUnlessLeftAsync(generation);
        }
    }

    private async Task RefuseUnlessLeftAsync(int generation)
    {
        if (generation == _generation)
        {
            await OnSpaceRefused.InvokeAsync(null);
        }
    }

    private void OpenCreate()
    {
        _creating = true;
        _newName = string.Empty;
        _createMessage = null;
        _createRefusal = null;
    }

    private void CloseCreate()
    {
        _creating = false;
        _createMessage = null;
        _createRefusal = null;
    }

    private void CreateKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !_submitting)
        {
            CloseCreate();
        }
    }

    private async Task CreateAsync()
    {
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        _createMessage = null;
        _createRefusal = null;

        var generation = _generation;
        var request = new CreateProjectRequest(_newName);

        // An attempt that never got an answer may still have been applied: sending the same name again
        // is a retry of that attempt and reuses its key, so the server replays it rather than creating a
        // second Project. Any answer ends the attempt.
        var key = _unanswered is { } unanswered && string.Equals(unanswered.Name, _newName, StringComparison.Ordinal)
            ? unanswered.Key
            : Guid.NewGuid().ToString("D");

        _unanswered = new UnansweredCreate(_newName, key);

        try
        {
            using var answer = await SendAsync(HttpMethod.Post, ProjectRoutes.ListIn(SpaceId), request, key);

            // In flight means the first use of this key has not finished: a resend must still reuse it.
            if (answer.Problem?.Type != ProblemTypes.IdempotencyKeyInFlight)
            {
                _unanswered = null;
            }

            if (generation != _generation)
            {
                return;
            }

            if (answer.StatusCode == HttpStatusCode.Created
                && await answer.Response.Content.ReadFromJsonAsync<ProjectResponse>(JsonOptions, ActiveSpace.Token) is { } created
                && generation == _generation)
            {
                Add(created);
                _newName = string.Empty;
                _announcement = string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["ProjectCreated"], created.Name);
                return;
            }

            await RefuseCreateAsync(answer);
        }
        catch (OperationCanceledException)
        {
            // The tab left this Space, or the Session ended, while the answer was on its way.
        }
        catch (HttpRequestException)
        {
            _createRefusal = Localizer[RefusalCopy.NotAvailableKey];
        }
        catch (JsonException)
        {
            _createRefusal = Localizer[RefusalCopy.NotAvailableKey];
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// A refused creation: an invalid name beside the field; the bound, or a Role changed under the
    /// page, inline in the creation surface in RefusalCopy's words; the Space itself refused, the one
    /// refusal surface. A 401 is YelloApiHandler's.
    /// </summary>
    private async Task RefuseCreateAsync(SpaceWriteAnswer answer)
    {
        switch (answer.StatusCode)
        {
            case HttpStatusCode.Unauthorized:
                return;

            case HttpStatusCode.NotFound:
                await OnSpaceRefused.InvokeAsync(answer.Problem);
                return;

            case HttpStatusCode.BadRequest when answer.Problem?.Type == ProblemTypes.InvalidProjectName:
                _createMessage = Localizer["ProjectNameInvalid"];
                return;

            default:
                _createRefusal = RefusalText(answer.Problem);
                return;
        }
    }

    private void StartRename(ProjectResponse project)
    {
        // One rename at a time: its answer closes the field it was sent from, so another row's field
        // must not open while it is on its way.
        if (_renameInFlight || _deletingProject is not null)
        {
            return;
        }

        _confirmingDelete = null;
        _renaming = project.Id;
        _renameName = project.Name;
        _renameMessage = null;
        _rowRefusal = null;
    }

    private void CancelRename()
    {
        _renaming = null;
        _renameMessage = null;
    }

    private void RenameNameChanged(string value) => _renameName = value;

    /// <summary>
    /// Renames a Project. Not optimistic: the field stays open, holding the new name, until the server
    /// answers; then the row shows the answer's name, or the field says why it was refused.
    /// </summary>
    private async Task RenameAsync(ProjectResponse original)
    {
        var name = _renameName.Trim();

        if (_renameInFlight)
        {
            return;
        }

        if (name.Length is < 1 or > 100)
        {
            _renameMessage = Localizer["ProjectNameInvalid"];
            return;
        }

        _renameInFlight = true;
        _renameMessage = null;
        _rowRefusal = null;

        var generation = _generation;

        try
        {
            using var answer = await SendAsync(
                HttpMethod.Patch,
                ProjectRoutes.ProjectOf(SpaceId, original.Id),
                new RenameProjectRequest(name),
                Guid.NewGuid().ToString("D"));

            if (generation == _generation && answer.StatusCode != HttpStatusCode.Unauthorized)
            {
                await UseRenameAnswerAsync(answer, original, generation);
            }
        }
        catch (OperationCanceledException)
        {
            // The tab left this Space, or the Session ended.
        }
        catch (HttpRequestException)
        {
            RefuseRenameUnlessLeft(original, generation);
        }
        catch (JsonException)
        {
            RefuseRenameUnlessLeft(original, generation);
        }
        finally
        {
            _renameInFlight = false;
        }
    }

    /// <summary>
    /// The server's answer to a rename: the renamed row; an invalid name beside the field; anything else
    /// on the row, in RefusalCopy's words. A 401 never reaches here - it is YelloApiHandler's.
    /// </summary>
    private async Task UseRenameAnswerAsync(SpaceWriteAnswer answer, ProjectResponse original, int generation)
    {
        if (answer.StatusCode == HttpStatusCode.OK
            && await answer.Response.Content.ReadFromJsonAsync<ProjectResponse>(JsonOptions, ActiveSpace.Token) is { } renamed
            && generation == _generation)
        {
            Replace(renamed);
            _renaming = null;
            _announcement = string.Format(System.Globalization.CultureInfo.CurrentCulture, Localizer["ProjectRenamed"], renamed.Name);
            return;
        }

        if (answer.Problem?.Type == ProblemTypes.InvalidProjectName)
        {
            _renameMessage = Localizer["ProjectNameInvalid"];
            return;
        }

        _renaming = null;
        _rowRefusal = new RowRefusal(original.Id, RefusalText(answer.Problem));
    }

    private void RefuseRenameUnlessLeft(ProjectResponse original, int generation)
    {
        if (generation == _generation)
        {
            _renaming = null;
            _rowRefusal = new RowRefusal(original.Id, Localizer[RefusalCopy.NotAvailableKey]);
        }
    }

    /// <summary>
    /// The row's delete control: the list is read again first, so the confirm states the Project's true Task count as it is now
    /// (story 2.5, open question 2 (a)); the confirm opens only once it has. A Project the read no longer lists has gone,
    /// and its row with it.
    /// </summary>
    private async Task AskToDeleteAsync(ProjectResponse project)
    {
        if (_renameInFlight || _counting is not null || _deletingProject is not null)
        {
            return;
        }

        _renaming = null;
        _confirmingDelete = null;
        _rowRefusal = null;
        _counting = project.Id;

        var generation = _generation;
        var token = ActiveSpace.Token;

        try
        {
            using var response = await Http.GetAsync(new Uri(ProjectRoutes.ListIn(SpaceId), UriKind.Relative), token);

            if (generation == _generation && !token.IsCancellationRequested)
            {
                await UseCountAnswerAsync(project, response, generation, token);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The tab left this Space, or the Session ended.
        }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or JsonException)
        {
            if (generation == _generation)
            {
                _rowRefusal = new RowRefusal(project.Id, Localizer[RefusalCopy.NotAvailableKey]);
            }
        }
        finally
        {
            if (generation == _generation)
            {
                _counting = null;
            }
        }
    }

    /// <summary>
    /// The list read for the confirm: the fresh list (and its counts) replaces the one shown; a 404 is the Space refusal
    /// surface; anything else is said on the row and no confirm opens.
    /// </summary>
    private async Task UseCountAnswerAsync(ProjectResponse project, HttpResponseMessage response, int generation, CancellationToken token)
    {
        if (response.IsSuccessStatusCode)
        {
            if (await response.Content.ReadFromJsonAsync<List<ProjectResponse>>(JsonOptions, token) is { } projects && generation == _generation)
            {
                _projects = projects;
                _confirmingDelete = projects.Exists(candidate => candidate.Id == project.Id) ? project.Id : null;
            }

            return;
        }

        if (response.StatusCode == HttpStatusCode.NotFound)
        {
            await OnSpaceRefused.InvokeAsync(await ProblemOfAsync(response, token));
            return;
        }

        if (response.StatusCode != HttpStatusCode.Unauthorized)
        {
            _rowRefusal = new RowRefusal(project.Id, RefusalText(await ProblemOfAsync(response, token)));
        }
    }

    private void CancelDelete()
    {
        _confirmingDelete = null;
        _rowRefusal = null;
    }

    /// <summary>
    /// The confirm's danger action (story 2.5, AC12). Not optimistic: the row stays until the server's <c>204</c>.
    /// </summary>
    private async Task DeleteAsync(ProjectResponse project)
    {
        if (!_canManage || _deletingProject is not null)
        {
            return;
        }

        _deletingProject = project.Id;
        _rowRefusal = null;

        var generation = _generation;
        var token = ActiveSpace.Token;

        // A deletion sent again after an attempt that got no answer reuses its key: it may have been applied.
        if (!_deleteKeys.TryGetValue(project.Id, out var key))
        {
            key = Guid.NewGuid().ToString("D");
            _deleteKeys[project.Id] = key;
        }

        try
        {
            using var answer = await Writes.SendWithoutBodyAsync(HttpMethod.Delete, ProjectRoutes.ProjectOf(SpaceId, project.Id), key, token);

            if (generation == _generation)
            {
                await UseDeletionAnswerAsync(project, answer);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The tab left this Space, or the Session ended.
        }
        catch (Exception exception) when (exception is OperationCanceledException or HttpRequestException or JsonException)
        {
            // No answer: nothing is removed, the key is kept for the resend, and the row says so.
            if (generation == _generation)
            {
                _rowRefusal = new RowRefusal(project.Id, Localizer["TaskEditNotSent"]);
            }
        }
        finally
        {
            if (generation == _generation)
            {
                _deletingProject = null;
            }
        }
    }

    private async Task UseDeletionAnswerAsync(ProjectResponse project, SpaceWriteAnswer answer)
    {
        switch (answer.StatusCode)
        {
            case HttpStatusCode.NoContent:
                _deleteKeys.Remove(project.Id);
                _projects?.RemoveAll(candidate => candidate.Id == project.Id);
                _confirmingDelete = null;
                _announcement = Localizer["ProjectDeleted"];
                _focusHeading = true;
                return;

            case >= HttpStatusCode.InternalServerError:
                // The outcome is not known: treated as no answer, so the key is kept.
                _rowRefusal = new RowRefusal(project.Id, Localizer["TaskEditNotSent"]);
                return;

            case HttpStatusCode.Unauthorized:
                return;

            case HttpStatusCode.NotFound:
                _deleteKeys.Remove(project.Id);
                await OnSpaceRefused.InvokeAsync(answer.Problem);
                return;

            default:
                if (answer.Problem?.Type != ProblemTypes.IdempotencyKeyInFlight)
                {
                    _deleteKeys.Remove(project.Id);
                }

                _rowRefusal = new RowRefusal(project.Id, RefusalText(answer.Problem));
                return;
        }
    }

    private void Add(ProjectResponse project)
    {
        _projects ??= [];
        _projects.Add(project);
        Order();
    }

    private void Replace(ProjectResponse project)
    {
        if (_projects is null)
        {
            return;
        }

        var index = _projects.FindIndex(candidate => candidate.Id == project.Id);

        if (index >= 0)
        {
            _projects[index] = project;
            Order();
        }
    }

    /// <summary>
    /// By name, then by id (open question 8). This is close to the server's order but not identical: the
    /// server compares names by the column's collation and ids as SQL Server orders them. A reload shows
    /// the server's order.
    /// </summary>
    private void Order() =>
        _projects?.Sort((left, right) =>
        {
            var byName = string.Compare(left.Name, right.Name, StringComparison.CurrentCulture);

            return byName != 0 ? byName : left.Id.CompareTo(right.Id);
        });

    private string RefusalText(ProblemResponse? problem) => Refusals.RefusalText.Of(Localizer, problem);

    private Task<SpaceWriteAnswer> SendAsync(HttpMethod method, string path, object body, string key) =>
        Writes.SendAsync(method, path, body, key, ActiveSpace.Token);

    private static Task<ProblemResponse?> ProblemOfAsync(HttpResponseMessage response, CancellationToken token) =>
        SpaceWrites.ProblemOfAsync(response, token);

    /// <summary>
    /// Why a row's rename, count read or deletion was refused, shown on that row.
    /// </summary>
    private sealed record RowRefusal(Guid ProjectId, string Text);

    /// <summary>
    /// A creation sent with no answer yet: its name, exactly as sent, and its Idempotency-Key.
    /// </summary>
    private sealed record UnansweredCreate(string Name, string Key);
}
