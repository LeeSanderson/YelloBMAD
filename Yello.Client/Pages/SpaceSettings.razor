@page "/spaces/{SpaceId:guid}/settings"

@using System.Globalization
@using Yello.Client.Spaces

@inject IStringLocalizer<ClientCopy> Localizer
@inject NavigationManager Navigation
@inject ActiveSpaceState ActiveSpace
@inject RoleNarrator Narrator

@implements IDisposable

@*
    A SPACE'S SETTINGS - story 2.4, open question 7: its Space name section (story 3.1, AC3), its Labels section, its
    Members section (story 4.4: every Membership with its address and Role, and the Role change; above the Invitations, the
    mockup's order) and its Invitations section (story 4.1's invite form and story 4.2's pending list with its revoke, one
    section); later stories add their own sections (deferred-work.md). FR-22; UX-DR27, UX-DR29, UX-DR31, UX-DR32, UX-DR33.

    ARRIVES LIKE EVERY SPACE-SCOPED PAGE, through SpaceArrival: an unlisted Space is refused with no request, the
    Role is the server's answer on this load, and a 404 renders the one refusal surface. The address holds ids only,
    and the document's title stays the product's name.

    OWNER AND ADMIN ONLY (SpaceCapabilities.PermitsSpaceSettings, the union of its sections' predicates). The context
    bar links here only for them; each section renders only for a Role its own predicate admits. A
    Member or Viewer who arrives by the address is taken to Space home and told, politely, that Space settings is for
    Owners and Admins: nothing of this page renders for them on the way.

    THE DELETE SECTION (story 3.3) IS THE OWNER'S ALONE (SpaceCapabilities.PermitsDeleteSpace), and absent for every
    other Role. Its confirm REPLACES this panel's content in place while it is open (AC7, EXPERIENCE.md:67): the name
    and Label sections are not rendered, and nothing is stacked on them. Esc or Cancel brings them back.

    A ROLE THAT DROPS BELOW THIS PAGE WHILE HERE: the drop is narrated with this page's sentence,
    focus moves to the narration, and only then does the page route to Space home, where the narration stays and keeps
    focus. Until the route the page keeps its last permitted render, so it is never blanked or half-rendered under the
    lower Role.
*@

<SpaceArrival SpaceId="@SpaceId" Context="arrival">
    <div class="space-settings">
        <PageHeading>@Localizer["SpaceSettingsHeading"]</PageHeading>

        @{ var role = RoleShown(arrival.Current.Role); }
        @{ var permitted = Permitted(role); }

        @if (permitted && ShowsSections(role))
        {
            @if (SpaceCapabilities.PermitsRenameSpace(role))
            {
                <SpaceNameSection @key="(SectionKey.Name, SpaceId)" SpaceId="@SpaceId" CurrentName="@arrival.Current.Name" OnSpaceRefused="arrival.Refuse" />
            }

            @if (LabelCapabilities.PermitsManageLabels(role))
            {
                <LabelSection @key="(SectionKey.Labels, SpaceId)" SpaceId="@SpaceId" OnSpaceRefused="arrival.Refuse" />
            }

            @if (MembershipCapabilities.PermitsManageMemberships(role))
            {
                <MembershipSection @key="(SectionKey.Memberships, SpaceId)" SpaceId="@SpaceId" ViewerRole="@role" OnSpaceRefused="arrival.Refuse" OnRoleDoubted="arrival.Reread" />
            }

            @if (InvitationCapabilities.PermitsIssueInvitations(role))
            {
                <InvitationSection @key="(SectionKey.Invitations, SpaceId)" SpaceId="@SpaceId" OnSpaceRefused="arrival.Refuse" />
            }
        }

        @if (permitted && SpaceCapabilities.PermitsDeleteSpace(role))
        {
            <SpaceDeleteSection @key="(SectionKey.Delete, SpaceId)" SpaceId="@SpaceId" @bind-Confirming="_confirmingDelete" OnSpaceRefused="arrival.Refuse" />
        }
    </div>
</SpaceArrival>

@code {
    // Each section is keyed on the Space, so a change of Space starts it again, and on its own kind, because sibling keys
    // must be unique: the delete confirm removes the other sections in place (story 3.3, AC7), which the renderer diffs.
    private enum SectionKey
    {
        Name,
        Labels,
        Memberships,
        Invitations,
        Delete,
    }

    private bool _confirmingDelete;
    private bool _leaving;
    private string? _leavingRole;
    private Guid _spaceSeen;

    /// <summary>
    /// The Space this route names.
    /// </summary>
    [Parameter]
    public Guid SpaceId { get; set; }

    /// <summary>
    /// The router reuses this page when only the Space changes (another Space's settings, back or forward): what an
    /// earlier Space permitted says nothing about this one, so it starts again.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (SpaceId != _spaceSeen)
        {
            _spaceSeen = SpaceId;
            _leaving = false;
            _leavingRole = null;
            _confirmingDelete = false;
        }
    }

    /// <inheritdoc />
    protected override void OnInitialized() => ActiveSpace.RoleDropping += OnRoleDropping;

    /// <inheritdoc />
    public void Dispose() => ActiveSpace.RoleDropping -= OnRoleDropping;

    /// <summary>
    /// The Role the page renders under: the one held, or, once a drop below this page is under way, the last one that
    /// permitted it, so nothing renders again under the lower Role before the route.
    /// </summary>
    private string RoleShown(string roleCode) => _leavingRole ?? roleCode;

    /// <summary>
    /// A drop while this page shows: one that still permits it changes the sections in place; one below it narrates this
    /// page's sentence, takes focus to the narration, and then routes to Space home.
    /// </summary>
    private void OnRoleDropping(object? sender, RoleDropEventArgs drop)
    {
        if (_leaving || ActiveSpace.SpaceId != SpaceId || SpaceCapabilities.PermitsSpaceSettings(drop.To) || !SpaceCapabilities.PermitsSpaceSettings(drop.From))
        {
            return;
        }

        _leaving = true;
        _leavingRole = drop.From;
        drop.LeaveSurface(string.Format(CultureInfo.CurrentCulture, Localizer["SpaceSettingsNoLongerAvailable"], Localizer[RoleCopy.NameKey(drop.To)]));

        var spaceId = SpaceId;

        _ = InvokeAsync(async () =>
        {
            await drop.Narrated;

            // Through the one door: a no-op purge while the tab is still in this Space, and a purge if it has left.
            Navigation.GoTo(ActiveSpace, ClientRoutes.SpaceHome(spaceId));
        });
    }

    /// <summary>
    /// Whether the panel's sections render: not while the Owner's delete confirm replaces them in place (story 3.3, AC7).
    /// </summary>
    private bool ShowsSections(string roleCode) => !(_confirmingDelete && SpaceCapabilities.PermitsDeleteSpace(roleCode));

    /// <summary>
    /// Whether the Role permits this page. One that never did - an address typed by hand - is taken to Space home and
    /// told why, politely, since nothing changed under the person; nothing of the page renders on the way.
    /// </summary>
    private bool Permitted(string roleCode)
    {
        var permitted = SpaceCapabilities.PermitsSpaceSettings(roleCode);

        if (!permitted && !_leaving)
        {
            _leaving = true;
            Narrator.Say(Localizer["SpaceSettingsForOwnersAndAdmins"], polite: true, survivesNextNavigation: true);

            var spaceId = SpaceId;

            // After this render, never during it.
            _ = InvokeAsync(() => Navigation.GoTo(ActiveSpace, ClientRoutes.SpaceHome(spaceId)));
        }

        return permitted;
    }
}
