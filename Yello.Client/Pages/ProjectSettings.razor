@page "/spaces/{SpaceId:guid}/projects/{ProjectId:guid}/settings"

@using Yello.Client.Spaces

@inject IStringLocalizer<ClientCopy> Localizer

@*
    A PROJECT'S SETTINGS: its Status delta editor (StatusDeltaEditor).

    ARRIVES LIKE EVERY SPACE-SCOPED PAGE, through SpaceArrival: an unlisted Space is refused with no request, the Role is
    the server's answer on this load, and every 404 - the Space's or the Project's - renders the one refusal surface. The
    address holds ids only, and the document's title stays the product's name (UX-DR33).

    LINKED FOR OWNER AND ADMIN ONLY (StatusCapabilities), but READABLE BY EVERY ROLE: reading a Project's Statuses is the
    capability every Role holds, so a Member or Viewer who arrives by the address sees the set read-only, with no control
    in the DOM, rather than a refusal that would treat a readable page as a boundary.
*@

<SpaceArrival SpaceId="@SpaceId" Context="arrival">
    <div class="project-settings">
        <PageHeading>@Localizer["ProjectSettingsHeading"]</PageHeading>

        <a class="project-settings__back" href="@ClientRoutes.Board(SpaceId, ProjectId)">@Localizer["ProjectSettingsBack"]</a>

        <StatusDeltaEditor @key="(SpaceId, ProjectId)"
                           SpaceId="@SpaceId"
                           ProjectId="@ProjectId"
                           CanEdit="@StatusCapabilities.PermitsConfigureProjectStatusDelta(arrival.Current.Role)"
                           OnRefused="arrival.Refuse" />
    </div>
</SpaceArrival>

@code {
    /// <summary>
    /// The Space this route names.
    /// </summary>
    [Parameter]
    public Guid SpaceId { get; set; }

    /// <summary>
    /// The Project whose settings these are.
    /// </summary>
    [Parameter]
    public Guid ProjectId { get; set; }
}
